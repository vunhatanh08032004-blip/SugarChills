<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.Release.config: CHỈ áp dụng khi Publish với cấu hình Release (lúc deploy lên host).
  Chạy trên máy (Debug, F5) vẫn dùng chuỗi kết nối trong Web.config như cũ.

  CẦN SỬA 4 CHỖ trong dòng connectionString bên dưới (lấy trong trang quản lý database của MonsterASP):
    SERVER_HOST   -> địa chỉ server, ví dụ: db12345.public.databaseasp.net
    TEN_DATABASE  -> tên database,   ví dụ: db12345
    USER_DB       -> tên đăng nhập,   ví dụ: db12345
    MAT_KHAU_DB   -> mật khẩu database
  Lưu ý: KHÔNG đẩy mật khẩu thật lên GitHub công khai.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="QL_MatHangAnUongEntities"
         connectionString="metadata=res://*/Models.QL_MatHangAnUong.csdl|res://*/Models.QL_MatHangAnUong.ssdl|res://*/Models.QL_MatHangAnUong.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=SERVER_HOST;initial catalog=TEN_DATABASE;user id=USER_DB;password=MAT_KHAU_DB;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         providerName="System.Data.EntityClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- Trên host: khách thấy trang lỗi thân thiện thay vì chi tiết lỗi kỹ thuật -->
    <customErrors mode="RemoteOnly" xdt:Transform="Insert" />
  </system.web>
</configuration>

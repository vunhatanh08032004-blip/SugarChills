    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- ===== ĐĂNG NHẬP GOOGLE / FACEBOOK (OAuth 2.0) =====
         GIÁ TRỊ THẬT đặt trong file Secrets.config (cùng thư mục, KHÔNG đưa lên Git) — file đó ghi đè các dòng trống bên dưới.
         Để trống ở cả hai nơi thì nút Google/Facebook chỉ báo "chưa cấu hình".
         Google  : console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
                   Authorized redirect URI:  https://localhost:44373/TaiKhoan/GoogleCallback
         Facebook: developers.facebook.com > My Apps > Create App > Facebook Login
                   Valid OAuth Redirect URI: https://localhost:44373/TaiKhoan/FacebookCallback
         KHÔNG đẩy Secret thật lên GitHub công khai. -->
    <add key="GoogleClientId" value="" />
    <add key="GoogleClientSecret" value="" />
    <add key="FacebookAppId" value="" />
    <add key="FacebookAppSecret" value="" />
  </appSettings>

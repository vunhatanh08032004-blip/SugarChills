<?xml version="1.0" encoding="utf-8"?>
<!-- FILE MẪU — copy thành "Secrets.config" rồi điền mã thật.
     Mỗi thành viên tự tạo file này (copy từ Secrets.config.example) và điền mã của mình.
     Web.config đọc file này qua: <appSettings file="Secrets.config"> -->
<appSettings>
  <add key="GoogleClientId" value="" />
  <add key="GoogleClientSecret" value="" />
  <add key="FacebookAppId" value="" />
  <add key="FacebookAppSecret" value="" />
</appSettings>

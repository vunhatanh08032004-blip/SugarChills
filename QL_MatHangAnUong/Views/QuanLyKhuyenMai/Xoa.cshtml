@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.KhuyenMai
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Xóa khuyến mãi";
}

<div class="sc-panel" style="max-width:620px;margin:0 auto">
    <div class="text-center mb-3">
        <div class="sc-feature-icon mx-auto mb-2"
             style="width:66px;height:66px;font-size:28px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h4>Xác nhận xóa chương trình</h4>
        <p class="sc-text-muted">Khách sẽ không dùng được mã này nữa sau khi xóa.</p>
    </div>

    <div class="p-3" style="background:var(--sc-primary-softer);border-radius:14px">
        <div class="fw-bold" style="font-size:17px">@Model.TenKM</div>
        <div class="mt-2">
            <span class="sc-chip">@Model.MaGiamGia.ToUpper()</span>
            <span class="sc-chip">Giảm @Model.PhanTramGiam%</span>
            <span class="sc-chip">Tối đa @DinhDang.Tien(Model.GiamToiDa)</span>
        </div>
        <div class="sc-text-muted small mt-2">
            Hiệu lực: @DinhDang.Ngay(Model.NgayBatDau) → @DinhDang.Ngay(Model.NgayKetThuc)
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        @using (Html.BeginForm("XacNhanXoa", "QuanLyKhuyenMai", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaKM" />
            <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-trash"></i> Xác nhận xóa</button>
        }
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Quay lại</a>
    </div>
</div>

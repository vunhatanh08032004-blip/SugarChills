@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.KhuyenMai
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = Resources.Strings.SellerKM_XoaTitle;
}

<div class="sc-panel" style="max-width:620px;margin:0 auto">
    <div class="text-center mb-3">
        <div class="sc-feature-icon mx-auto mb-2"
             style="width:66px;height:66px;font-size:28px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h4>@Resources.Strings.SellerKM_XacNhanXoaHeading</h4>
        <p class="sc-text-muted">@Resources.Strings.SellerKM_KhongDungDuocMoTa</p>
    </div>

    <div class="p-3" style="background:var(--sc-primary-softer);border-radius:14px">
        <div class="fw-bold" style="font-size:17px">@Model.TenKM</div>
        <div class="mt-2">
            <span class="sc-chip">@Model.MaGiamGia.ToUpper()</span>
            <span class="sc-chip">@(string.Format(Resources.Strings.SellerKM_GiamFormat, Model.PhanTramGiam))</span>
            <span class="sc-chip">@(string.Format(Resources.Strings.SellerKM_ToiDaFormat, DinhDang.Tien(Model.GiamToiDa)))</span>
        </div>
        <div class="sc-text-muted small mt-2">
            @(string.Format(Resources.Strings.SellerKM_HieuLucFormat, DinhDang.Ngay(Model.NgayBatDau), DinhDang.Ngay(Model.NgayKetThuc)))
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        @using (Html.BeginForm("XacNhanXoa", "QuanLyKhuyenMai", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaKM" />
            <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-trash"></i> @Resources.Strings.Admin_XacNhanXoa</button>
        }
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">@Resources.Strings.Admin_QuayLai</a>
    </div>
</div>

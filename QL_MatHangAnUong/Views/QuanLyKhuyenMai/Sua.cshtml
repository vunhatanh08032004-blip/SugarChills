@model QL_MatHangAnUong.Models.KhuyenMai
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Sửa khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa: @Model.TenKM</h4>
    <a href="@Url.Action("Index")" class="btn btn-sc-soft"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

@using (Html.BeginForm("Sua", "QuanLyKhuyenMai", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_FormKhuyenMai", Model)

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-save"></i> Cập nhật</button>
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Hủy</a>
    </div>
}

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

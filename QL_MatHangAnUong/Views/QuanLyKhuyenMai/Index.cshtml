@using QL_MatHangAnUong.Helpers
@model List<QL_MatHangAnUong.Models.KhuyenMai>
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = Resources.Strings.Seller_QuanLyKhuyenMai;
}

<div class="sc-table-card">
    <div class="sc-table-head">
        <div>
            <h5>@Resources.Strings.SellerKM_ChuongTrinhKM</h5>
            <small class="sc-text-muted">@(string.Format(Resources.Strings.SellerKM_SoLuongFormat, Model.Count, Model.Count(k => k.ConHieuLuc)))</small>
        </div>
        <a href="@Url.Action("Them")" class="btn btn-sc"><i class="bi bi-plus-lg"></i> @Resources.Strings.SellerKM_ThemBtn</a>
    </div>

    <div class="table-responsive">
        <table class="table sc-table align-middle">
            <thead>
                <tr>
                    <th>@Resources.Strings.SellerKM_ColChuongTrinh</th>
                    <th>@Resources.Strings.SellerKM_ColMaGiamGia</th>
                    <th class="text-center">Loại</th>
                    <th class="text-center">@Resources.Strings.SellerKM_ColGiam</th>
                    <th class="text-end">@Resources.Strings.SellerKM_ColToiDa</th>
                    <th class="text-end">@Resources.Strings.SellerKM_ColDonToiThieu</th>
                    <th class="text-center">@Resources.Strings.SellerKM_ColThoiGian</th>
                    <th class="text-center">@Resources.Strings.Account_TrangThai</th>
                    <th class="text-end" style="width:190px">@Resources.Strings.Admin_ThaoTac</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center py-5 sc-text-muted">@Resources.Strings.SellerKM_ChuaCoChuongTrinh</td></tr>
                }
                else
                {
                    foreach (var km in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@km.TenKM</div>
                                <div class="sc-text-muted" style="font-size:12px">@km.MoTa</div>
                            </td>
                            <td><span class="sc-chip">@km.MaGiamGia.ToUpper()</span></td>
                            <td class="text-center" style="font-size:12px">
                                @if (km.LoaiGiam == QL_MatHangAnUong.Models.KhuyenMai.GiamPhiGiaoHang)
                                {
                                    <span class="sc-badge badge-info">Phí giao hàng</span>
                                }
                                else
                                {
                                    <span class="sc-badge badge-muted">Tổng tiền</span>
                                }
                            </td>
                            <td class="text-center fw-bold sc-text-primary">@km.PhanTramGiam%</td>
                            <td class="text-end">@DinhDang.Tien(km.GiamToiDa)</td>
                            <td class="text-end">@(km.DonToiThieu > 0 ? DinhDang.Tien(km.DonToiThieu) : Resources.Strings.SellerProd_Khong)</td>
                            <td class="text-center" style="font-size:13px">
                                @DinhDang.Ngay(km.NgayBatDau)<br />→ @DinhDang.Ngay(km.NgayKetThuc)
                            </td>
                            <td class="text-center">
                                @if (km.ConHieuLuc)
                                {
                                    <span class="sc-badge badge-success">@Resources.Strings.SellerKM_DangChay</span>
                                }
                                else if (!km.KichHoat)
                                {
                                    <span class="sc-badge badge-muted">@Resources.Strings.SellerKM_DaTat</span>
                                }
                                else
                                {
                                    <span class="sc-badge badge-warning">@Resources.Strings.SellerKM_NgoaiThoiGian</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @using (Html.BeginForm("DoiTrangThai", "QuanLyKhuyenMai", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@km.MaKM" />
                                    <button type="submit" class="btn btn-sm btn-sc-soft" title="@(km.KichHoat ? Resources.Strings.SellerKM_TatTitle : Resources.Strings.SellerKM_BatTitle)">
                                        <i class="bi @(km.KichHoat ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                }
                                <a href="@Url.Action("Sua", new { id = km.MaKM })" class="btn btn-sm btn-sc-soft" title="@Resources.Strings.Admin_Sua">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("Xoa", new { id = km.MaKM })" class="btn btn-sm btn-sc-outline" title="@Resources.Strings.Common_Xoa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="sc-alert sc-alert-info mt-3">
    <i class="bi bi-info-circle"></i>
    <span>@Html.Raw(string.Format(Resources.Strings.SellerKM_GhiChuMaGiamGiaFormat, "<strong>" + Resources.Strings.Common_GioHang + "</strong>"))</span>
</div>

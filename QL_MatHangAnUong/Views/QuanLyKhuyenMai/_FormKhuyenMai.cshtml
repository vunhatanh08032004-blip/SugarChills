@model QL_MatHangAnUong.Models.KhuyenMai

@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
@Html.HiddenFor(m => m.MaKM)

<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc-panel">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label" for="TenKM">@Resources.Strings.SellerKM_TenChuongTrinhLabel</label>
                    @Html.TextBoxFor(m => m.TenKM, new { @class = "form-control", placeholder = Resources.Strings.SellerKM_TenKMPlaceholder })
                    @Html.ValidationMessageFor(m => m.TenKM)
                </div>

                <div class="col-md-5">
                    <label class="form-label" for="MaGiamGia">@Resources.Strings.SellerKM_ColMaGiamGia</label>
                    @Html.TextBoxFor(m => m.MaGiamGia, new { @class = "form-control text-uppercase", placeholder = "SUGAR10" })
                    @Html.ValidationMessageFor(m => m.MaGiamGia)
                    <small class="sc-text-muted">@Resources.Strings.SellerKM_MaHint</small>
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="PhanTramGiam">@Resources.Strings.SellerKM_PhanTramLabel</label>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.PhanTramGiam, new { @class = "form-control", type = "number", min = 0, max = 100 })
                        <span class="input-group-text">%</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.PhanTramGiam)
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="GiamToiDa">@Resources.Strings.SellerKM_GiamToiDaLabel</label>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.GiamToiDa, new { @class = "form-control", type = "number", min = 0, step = 1000 })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.GiamToiDa)
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="DonToiThieu">@Resources.Strings.SellerKM_DonToiThieuLabel</label>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.DonToiThieu, new { @class = "form-control", type = "number", min = 0, step = 1000 })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.DonToiThieu)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="NgayBatDau">@Resources.Strings.SellerKM_NgayBatDauLabel</label>
                    @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.NgayBatDau)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="NgayKetThuc">@Resources.Strings.SellerKM_NgayKetThucLabel</label>
                    @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.NgayKetThuc)
                </div>

                <div class="col-12">
                    <label class="form-label" for="MoTa">@Resources.Strings.SellerProd_MoTaLabel</label>
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3, placeholder = Resources.Strings.SellerKM_MoTaPlaceholder })
                </div>

                <div class="col-12">
                    <label class="sc-topping">
                        @Html.CheckBoxFor(m => m.KichHoat)
                        <span>@Resources.Strings.SellerKM_KichHoatCheckbox</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc-panel">
            <h5 class="mb-3">@Resources.Strings.SellerKM_CachHoatDongHeading</h5>
            <ol class="sc-text-muted" style="font-size:14px;padding-left:18px">
                <li class="mb-2">@Resources.Strings.SellerKM_Buoc1</li>
                <li class="mb-2">@Resources.Strings.SellerKM_Buoc2</li>
                <li class="mb-2">@Resources.Strings.SellerKM_Buoc3</li>
                <li>@Resources.Strings.SellerKM_Buoc4</li>
            </ol>

            <div class="sc-alert sc-alert-warning" style="font-size:13px">
                <i class="bi bi-exclamation-circle"></i>
                <span>@Resources.Strings.SellerKM_CanhBaoDuyNhat</span>
            </div>
        </div>
    </div>
</div>

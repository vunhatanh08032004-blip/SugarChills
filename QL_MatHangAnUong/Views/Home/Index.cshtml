@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.ViewModels.TrangChuViewModel
@{
    ViewBag.Title = Resources.Strings.Common_TrangChu;
    var soSPTheoLoai = ViewBag.SoSanPhamTheoLoai as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<!-- ================= HERO ================= -->
<section class="container mt-4">
    <div class="sc-hero">
        <span class="sc-blob sc-blob-1"></span>
        <span class="sc-blob sc-blob-2"></span>
        <div class="row align-items-center g-4 position-relative">
            <div class="col-lg-6">
                <span class="sc-hero-tag"><i class="bi bi-stars"></i> @Resources.Strings.Home_MoiMoiNgay</span>
                <h1>@Html.Raw(Resources.Strings.Home_HeroTitle)</h1>
                <p class="mb-4">
                    @Resources.Strings.Home_HeroMoTa
                </p>
                <a href="#danh-muc-yeu-thich" class="btn btn-sc btn-lg">
                    <i class="bi bi-cup-straw"></i> @Resources.Strings.About_XemThucDon
                </a>
                <a href="#khuyen-mai" class="btn btn-sc-outline btn-lg ms-2">@Resources.Strings.Home_UuDaiHomNay</a>
            </div>
            <div class="col-lg-6">
                <style>
                    /* Khung banner 16:9 trùng tỉ lệ ảnh (ảnh đã được Unsplash cắt sẵn 1280x720) => hiện trọn ảnh */
                    .sc-hero-carousel .sc-hero-img { aspect-ratio: 16 / 9; height: auto; max-height: none; width: 100%; object-fit: cover; display: block; }
                    .sc-hero-carousel .carousel-inner { overflow: hidden; box-shadow: 0 12px 40px rgba(232,81,127,.18); }
                    .sc-hero-carousel .carousel-indicators { justify-content: flex-end; margin-right: 16px; }
                </style>
                <!-- Banner ảnh tự chuyển (Bootstrap Carousel) — 4 ảnh ngang 16:9, tự chạy mỗi 4s -->
                <div id="heroCarousel" class="carousel slide carousel-fade sc-hero-carousel" data-bs-ride="carousel" data-bs-interval="4000">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="&#7842;nh 1"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="&#7842;nh 2"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="&#7842;nh 3"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3" aria-label="&#7842;nh 4"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://images.unsplash.com/photo-1741265805852-32186a6d0dd3?auto=format&fit=crop&crop=entropy&w=1280&h=720&q=80"
                                 class="sc-hero-img" alt="Kh&#244;ng gian qu&#225;n SugarChills"
                                 data-fallback="https://placehold.co/1280x720/FFE6EE/E8517F?text=SugarChills" />
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1531264071041-3a69924b182d?auto=format&fit=crop&crop=entropy&w=1280&h=720&q=80"
                                 class="sc-hero-img" alt="Ly tr&#224; chanh g&#7915;ng m&#225;t l&#7841;nh"
                                 data-fallback="https://placehold.co/1280x720/FFE6EE/E8517F?text=SugarChills" />
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1694339487658-0ef17dacae9b?auto=format&fit=crop&crop=entropy&w=1280&h=720&q=80"
                                 class="sc-hero-img" alt="B&#224;n gh&#7871; c&#7841;nh c&#7917;a s&#7893;"
                                 data-fallback="https://placehold.co/1280x720/FFE6EE/E8517F?text=SugarChills" />
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&crop=entropy&w=1280&h=720&q=80"
                                 class="sc-hero-img" alt="Ly c&#224; ph&#234;"
                                 data-fallback="https://placehold.co/1280x720/FFE6EE/E8517F?text=SugarChills" />
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="sc-carousel-arrow"><i class="bi bi-chevron-left"></i></span>
                        <span class="visually-hidden">@Resources.Strings.Home_AnhTruoc</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="sc-carousel-arrow"><i class="bi bi-chevron-right"></i></span>
                        <span class="visually-hidden">@Resources.Strings.Home_AnhSau</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= CAM KẾT ================= -->
<section class="container mt-4">
    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <div class="sc-feature">
                <div class="sc-feature-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <div><strong>@Resources.Strings.Home_GiaoNhanh</strong><div class="sc-text-muted small">@Resources.Strings.Home_GiaoNhanhMoTa</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-feature">
                <div class="sc-feature-icon"><i class="bi bi-cup-hot-fill"></i></div>
                <div><strong>@Resources.Strings.Home_PhaMoiNgay</strong><div class="sc-text-muted small">@Resources.Strings.Home_PhaMoiNgayMoTa</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-feature">
                <div class="sc-feature-icon"><i class="bi bi-truck"></i></div>
                <div><strong>@Resources.Strings.Home_Freeship</strong><div class="sc-text-muted small">@Resources.Strings.Home_FreeshipMoTa</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sc-feature">
                <div class="sc-feature-icon"><i class="bi bi-heart-fill"></i></div>
                <div><strong>@Resources.Strings.Home_TuyChon</strong><div class="sc-text-muted small">@Resources.Strings.Home_TuyChonMoTa</div></div>
            </div>
        </div>
    </div>
</section>

<!-- ================= DANH MỤC ================= -->
<section class="container sc-section" id="danh-muc-yeu-thich" style="scroll-margin-top:90px">
    <div class="sc-section-head">
        <div>
            <h2>@Resources.Strings.Home_DanhMucYeuThich</h2>
            <div class="sc-sub">@Resources.Strings.Home_ChonNhanh</div>
        </div>
        <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc-soft">@Resources.Strings.Common_TatCa <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-3">
        @foreach (var loai in Model.DanhSachLoai)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a href="@Url.Action("Index", "SanPham", new { maLoai = loai.MaLoai })" class="sc-cat">
                    <img src="@loai.HinhAnh" alt="@loai.TenLoai"
                         data-fallback="https://placehold.co/200x200/FFE6EE/E8517F?text=SC" />
                    <span>@loai.TenLoai</span>
                    <small>@(string.Format(Resources.Strings.Home_SoMonCount, soSPTheoLoai.ContainsKey(loai.MaLoai) ? soSPTheoLoai[loai.MaLoai] : 0))</small>
                </a>
            </div>
        }
    </div>
</section>

<!-- ================= SẢN PHẨM NỔI BẬT ================= -->
<section class="container sc-section pt-0" id="mon-noi-bat" style="scroll-margin-top:90px">
    <div class="sc-section-head">
        <div>
            <h2>@Resources.Strings.Home_MonNoiBat</h2>
            <div class="sc-sub">@Resources.Strings.Home_MonNoiBatMoTa</div>
        </div>
        <a href="@Url.Action("Index", "SanPham", new { sapXep = "ban-chay", an = true })" class="btn btn-sc-soft">
            @Resources.Strings.Common_XemThem <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-3 g-lg-4">
        @foreach (var sp in Model.SanPhamNoiBat)
        {
            <div class="col-6 col-md-4 col-lg-3">
                @Html.Partial("_CardSanPham", sp)
            </div>
        }
    </div>
</section>

<!-- ================= KHUYẾN MÃI ================= -->
<section class="container sc-section pt-0" id="khuyen-mai" style="scroll-margin-top:90px">
    <div class="sc-section-head">
        <div>
            <h2>@Resources.Strings.Home_UuDaiDangChay</h2>
            <div class="sc-sub">@Resources.Strings.Home_UuDaiMoTa</div>
        </div>
        <a href="@Url.Action("KhuyenMai", "Home")" class="btn btn-sc-soft">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var km in Model.KhuyenMais)
        {
            <div class="col-md-4">
                <div class="sc-panel h-100 d-flex align-items-center gap-3">
                    <div class="sc-feature-icon" style="width:56px;height:56px;flex:0 0 56px;font-size:24px">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold" style="color:var(--sc-brown)">@km.TenKM</div>
                        <div class="small sc-text-muted">@km.MoTa</div>
                        <div class="mt-2">
                            <span class="sc-chip">@Resources.Strings.Home_Ma @km.MaGiamGia.ToUpper()</span>
                            <span class="small sc-text-muted">@Resources.Strings.Home_HSD @DinhDang.Ngay(km.NgayKetThuc)</span>
                        </div>
                        <div class="small sc-text-muted mt-1">@km.TenLoaiGiam</div>
                    </div>
                </div>
            </div>
        }
        @if (Model.KhuyenMais.Count == 0)
        {
            <div class="col-12">
                <div class="sc-panel text-center sc-text-muted">@Resources.Strings.Home_ChuaCoKhuyenMai</div>
            </div>
        }
    </div>
</section>

<!-- ================= ĐANG GIẢM GIÁ ================= -->
@if (Model.SanPhamGiamGia.Count > 0)
{
    <section class="container sc-section pt-0" id="dang-giam-gia" style="scroll-margin-top:90px">
        <div class="sc-section-head">
            <div>
                <h2>@Resources.Strings.Home_DangGiamGia</h2>
                <div class="sc-sub">@Resources.Strings.Home_DangGiamGiaMoTa</div>
            </div>
            <a href="@Url.Action("Index", "SanPham", new { sapXep = "giam-gia", an = true })" class="btn btn-sc-soft">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-3 g-lg-4">
            @foreach (var sp in Model.SanPhamGiamGia)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @Html.Partial("_CardSanPham", sp)
                </div>
            }
        </div>
    </section>
}

<!-- ================= MÓN MỚI ================= -->
<section class="container sc-section pt-0">
    <div class="sc-section-head">
        <div>
            <h2>@Resources.Strings.Home_MonMoiLenKe</h2>
            <div class="sc-sub">@Resources.Strings.Home_MonMoiMoTa</div>
        </div>
        <a href="@Url.Action("Index", "SanPham", new { sapXep = "moi", an = true })" class="btn btn-sc-soft">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="row g-3 g-lg-4">
        @foreach (var sp in Model.SanPhamMoi)
        {
            <div class="col-6 col-md-4 col-lg-3">
                @Html.Partial("_CardSanPham", sp)
            </div>
        }
    </div>
</section>

<!-- ================= GIỚI THIỆU NGẮN ================= -->
<section class="container sc-section pt-0">
    <div class="sc-panel">
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <img src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=900&q=80"
                     class="w-100" style="border-radius:var(--sc-radius);max-height:300px;object-fit:cover"
                     alt="@Resources.Strings.Home_AltKhongGianSC"
                     data-fallback="https://placehold.co/900x600/FFE6EE/E8517F?text=SugarChills" />
            </div>
            <div class="col-lg-7">
                <h2 class="mb-3">@Resources.Strings.Home_MotNgum</h2>
                <p class="sc-text-muted">
                    @Resources.Strings.Home_MoTaNgan
                </p>
                <a href="@Url.Action("GioiThieu", "Home")" class="btn btn-sc-outline">@Resources.Strings.Home_TimHieuThem</a>
            </div>
        </div>
    </div>
</section>

@* ================= POPUP ƯU ĐÃI (hiện 1 lần mỗi phiên khi mở trang chủ) ================= *@
@if (Model.KhuyenMais.Count > 0)
{
    var kmPopup = Model.KhuyenMais.First();
    bool laFreeship = kmPopup.LoaiGiam == QL_MatHangAnUong.Models.KhuyenMai.GiamPhiGiaoHang;
    decimal mucFreeship = QL_MatHangAnUong.Controllers.GioHangController.MucMienPhiGiaoHang;

    // Cột 1: ưu đãi của mã
    string nhan1 = laFreeship ? "Ph\u00ed ship" : "Gi\u1ea3m";
    string so1 = (laFreeship && kmPopup.PhanTramGiam >= 100) ? "0\u0111" : kmPopup.PhanTramGiam + "%";
    string phu1 = kmPopup.DonToiThieu > 0 ? "\u0110\u01a1n t\u1eeb " + DinhDang.Tien(kmPopup.DonToiThieu) : "M\u1ecdi \u0111\u01a1n h\u00e0ng";

    // Cột 2: mã giảm tổng tiền -> nhắc chính sách freeship của quán; mã freeship -> mức giảm tối đa
    string nhan2 = laFreeship ? "Gi\u1ea3m t\u1ed1i \u0111a" : "Freeship";
    string so2 = laFreeship
        ? (kmPopup.GiamToiDa > 0 ? (kmPopup.GiamToiDa / 1000m).ToString("0") + "K" : "100%")
        : "0\u0111";
    string phu2 = laFreeship ? "M\u1ed7i \u0111\u01a1n h\u00e0ng" : "\u0110\u01a1n t\u1eeb " + DinhDang.Tien(mucFreeship);

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@700;800;900&display=swap" rel="stylesheet">

    <div class="modal fade" id="modalUuDai" tabindex="-1" aria-labelledby="tieuDeUuDai" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered sc-promo-dialog">
            <div class="modal-content sc-promo">
                <span class="sc-promo-glow"></span>
                <span class="sc-promo-circle"></span>

                <button type="button" class="sc-promo-close" data-bs-dismiss="modal" aria-label="&#272;&#243;ng">
                    <i class="bi bi-x-lg"></i>
                </button>

                <div class="sc-promo-badge">SUGARCHILLS SALE</div>
                <h3 class="sc-promo-title" id="tieuDeUuDai">@kmPopup.TenKM</h3>

                <div class="sc-promo-stats">
                    <div class="sc-promo-stat">
                        <div class="sc-promo-lbl">@nhan1</div>
                        <div class="sc-promo-num">@so1</div>
                        <div class="sc-promo-sub">@phu1</div>
                    </div>
                    <div class="sc-promo-divider"></div>
                    <div class="sc-promo-stat">
                        <div class="sc-promo-lbl">@nhan2</div>
                        <div class="sc-promo-num">@so2</div>
                        <div class="sc-promo-sub">@phu2</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(kmPopup.MoTa))
                {
                    <p class="sc-promo-desc">@kmPopup.MoTa</p>
                }

                <button type="button" class="sc-promo-code" data-ma="@kmPopup.MaGiamGia.ToUpper()" title="B&#7845;m &#273;&#7875; sao ch&#233;p m&#227;">
                    Nh&#7853;p m&#227; <strong>@kmPopup.MaGiamGia.ToUpper()</strong> <i class="bi bi-copy"></i>
                </button>

                <a href="@Url.Action("KhuyenMai", "Home")" class="sc-promo-cta">XEM &#431;U &#272;&#195;I NGAY</a>
            </div>
        </div>
    </div>

    <style>
        .sc-promo-dialog { max-width: 520px; padding: 0 12px; }
        .sc-promo {
            position: relative; overflow: hidden; border: 0; border-radius: 32px;
            padding: 44px 40px 36px; text-align: center; color: #fff;
            font-family: 'Be Vietnam Pro', sans-serif;
            background: linear-gradient(135deg, #ff7aa8 0%, #e8517f 42%, #f2766b 72%, #ffb36b 100%);
            box-shadow: 0 24px 70px rgba(232, 81, 127, .45);
            align-items: center;   /* .modal-content là flex dọc: không kéo giãn badge/nút mã */
        }
        .sc-promo-stats, .sc-promo-desc, .sc-promo-cta { align-self: stretch; }
        /* Vệt sáng mềm góc trên trái + vòng tròn trang trí góc dưới phải */
        .sc-promo-glow {
            position: absolute; top: -90px; left: -90px; width: 260px; height: 260px; border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,.35), rgba(255,255,255,0) 70%); pointer-events: none;
        }
        .sc-promo-circle {
            position: absolute; right: -70px; bottom: -80px; width: 240px; height: 240px; border-radius: 50%;
            background: rgba(255, 236, 160, .35); pointer-events: none;
        }
        .sc-promo > *:not(span) { position: relative; z-index: 1; }
        .sc-promo .sc-promo-close {
            position: absolute; top: 18px; right: 18px; z-index: 2;
            width: 44px; height: 44px; border-radius: 50%; border: 0;
            background: rgba(255,255,255,.92); color: #2d1a24; font-size: 18px;
            display: flex; align-items: center; justify-content: center; transition: transform .2s;
        }
        .sc-promo .sc-promo-close:hover { transform: rotate(90deg); }
        .sc-promo-badge {
            display: inline-block; padding: 7px 18px; border-radius: 999px;
            background: rgba(255,255,255,.22); font-size: 13px; font-weight: 800; letter-spacing: .12em;
        }
        .sc-promo-title { font-family: inherit; font-size: 40px; font-weight: 900; margin: 16px 0 22px; line-height: 1.15; color: #fff; }
        .sc-promo-stats { display: flex; align-items: stretch; justify-content: center; }
        .sc-promo-stat { flex: 1; min-width: 0; }
        .sc-promo-divider { width: 1px; background: rgba(255,255,255,.45); margin: 6px 8px; }
        .sc-promo-lbl { font-size: 18px; font-weight: 700; opacity: .95; }
        .sc-promo-num { font-size: 76px; font-weight: 900; line-height: 1.05; letter-spacing: -2px; }
        .sc-promo-sub { font-size: 16px; font-weight: 700; opacity: .95; }
        .sc-promo-desc { font-size: 17px; font-weight: 700; margin: 22px 8px 14px; line-height: 1.5; }
        .sc-promo-code {
            background: transparent; color: #fff; border: 2px dashed rgba(255,255,255,.75);
            border-radius: 999px; padding: 6px 18px; font-size: 15px; font-weight: 600; margin-bottom: 18px;
            transition: background .2s;
        }
        .sc-promo-code:hover { background: rgba(255,255,255,.15); }
        .sc-promo-code strong { font-weight: 900; letter-spacing: .06em; }
        .sc-promo-cta {
            display: block; background: #fff; color: #e8517f; text-decoration: none;
            font-size: 18px; font-weight: 800; letter-spacing: .02em;
            padding: 16px; border-radius: 18px; transition: transform .2s, box-shadow .2s;
        }
        .sc-promo-cta:hover { color: #c2185b; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.15); }
        @@media (max-width: 480px) {
            .sc-promo { padding: 40px 22px 28px; }
            .sc-promo-title { font-size: 30px; }
            .sc-promo-num { font-size: 54px; }
        }
    </style>

    <script>
        // Bootstrap được nạp ở CUỐI _Layout (sau nội dung trang này)
        // => phải đợi DOMContentLoaded thì biến "bootstrap" mới tồn tại.
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('modalUuDai');
            if (!el || !window.bootstrap) return;

            // Bấm vào mã -> sao chép vào clipboard
            var nutMa = el.querySelector('.sc-promo-code');
            nutMa.addEventListener('click', function () {
                var ma = nutMa.getAttribute('data-ma');
                if (navigator.clipboard) navigator.clipboard.writeText(ma);
                nutMa.innerHTML = '<i class="bi bi-check2"></i> \u0110\u00e3 sao ch\u00e9p <strong>' + ma + '</strong>';
            });

            var KEY = 'sc_promo_@(kmPopup.MaKM)';
            try { if (sessionStorage.getItem(KEY)) return; } catch (e) { }   // đã xem trong phiên này

            // Đợi màn hình loading (~1.65s) tắt rồi mới mở popup
            setTimeout(function () {
                bootstrap.Modal.getOrCreateInstance(el).show();
                try { sessionStorage.setItem(KEY, '1'); } catch (e) { }
            }, 1800);
        });
    </script>
}

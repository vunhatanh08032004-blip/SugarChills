@{
    ViewBag.Title = Resources.Strings.Home_GioiThieuTitle;
}

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Common_GioiThieu</span>
    </div>

    <div class="sc-hero mb-4">
        <span class="sc-blob sc-blob-1"></span>
        <div class="row align-items-center g-4 position-relative">
            <div class="col-lg-7">
                <span class="sc-hero-tag">@Resources.Strings.About_TuNam</span>
                <h1>@Resources.Strings.About_CauChuyen</h1>
                <p>
                    @Resources.Strings.About_MoTaHero
                </p>
            </div>
            <div class="col-lg-5">
                <img src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=900&q=80"
                     class="sc-hero-img" alt="@Resources.Strings.About_AltKhongGianQuan"
                     onerror="this.onerror=null;this.src='https://placehold.co/900x600/FFE6EE/E8517F?text=SugarChills';" />
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="sc-panel">
                <h4>@Resources.Strings.About_LamGiMoiNgay</h4>
                <p class="sc-text-muted">
                    @Resources.Strings.About_MoTaLamViec
                </p>

                <h4 class="mt-4">@Resources.Strings.About_GiaTri</h4>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <div class="sc-feature">
                            <div class="sc-feature-icon"><i class="bi bi-basket"></i></div>
                            <div><strong>@Resources.Strings.About_NguyenLieuMinhBach</strong><div class="small sc-text-muted">@Resources.Strings.About_NguyenLieuMoTa</div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="sc-feature">
                            <div class="sc-feature-icon"><i class="bi bi-emoji-smile"></i></div>
                            <div><strong>@Resources.Strings.About_PhucVuTuTe</strong><div class="small sc-text-muted">@Resources.Strings.About_PhucVuMoTa</div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="sc-feature">
                            <div class="sc-feature-icon"><i class="bi bi-recycle"></i></div>
                            <div><strong>@Resources.Strings.About_LyThanThien</strong><div class="small sc-text-muted">@Resources.Strings.About_LyMoTa</div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="sc-feature">
                            <div class="sc-feature-icon"><i class="bi bi-piggy-bank"></i></div>
                            <div><strong>@Resources.Strings.About_GiaSinhVien</strong><div class="small sc-text-muted">@Resources.Strings.About_GiaSinhVienMoTa</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sc-panel">
                <h5>@Resources.Strings.About_TrongConSo</h5>
                <div class="d-flex justify-content-between py-2" style="border-bottom:1px solid var(--sc-line)">
                    <span class="sc-text-muted">@Resources.Strings.Store_CuaHang</span><strong>@Resources.Strings.About_ChiNhanh</strong>
                </div>
                <div class="d-flex justify-content-between py-2" style="border-bottom:1px solid var(--sc-line)">
                    <span class="sc-text-muted">@Resources.Strings.About_MonTrongMenu</span><strong>@Resources.Strings.About_SoMon</strong>
                </div>
                <div class="d-flex justify-content-between py-2" style="border-bottom:1px solid var(--sc-line)">
                    <span class="sc-text-muted">@Resources.Strings.About_KhachMoiNgay</span><strong>@Resources.Strings.About_LuotKhach</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="sc-text-muted">@Resources.Strings.About_ThoiGianGiao</span><strong>@Resources.Strings.About_PhutGiao</strong>
                </div>

                <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc w-100 mt-3">@Resources.Strings.About_XemThucDon</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewBag.Title = Resources.Strings.Common_LienHe;
}

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Common_LienHe</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="sc-panel h-100">
                <h4 class="mb-3">@Resources.Strings.Contact_TieuDe</h4>

                <div class="d-flex gap-3 mb-3">
                    <div class="sc-feature-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <strong>@Resources.Strings.Contact_CuaHangChinh</strong>
                        <div class="sc-text-muted small">12 Nguyễn Văn Bảo, P.4, Gò Vấp, TP.HCM</div>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-3">
                    <div class="sc-feature-icon"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <strong>@Resources.Strings.Contact_HotlineDatHang</strong>
                        <div class="sc-text-muted small">1900 6789 (07:00 - 22:00)</div>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-3">
                    <div class="sc-feature-icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <strong>@Resources.Strings.Common_Email</strong>
                        <div class="sc-text-muted small">hello@sugarchills.vn</div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="sc-feature-icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <strong>@Resources.Strings.Footer_GioMoCua</strong>
                        <div class="sc-text-muted small">@Resources.Strings.Footer_GioT2T6<br />@Resources.Strings.Footer_GioT7CN</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="sc-panel">
                <h4 class="mb-3">@Resources.Strings.Contact_GuiLoiNhan</h4>
                <p class="sc-text-muted small">
                    @Resources.Strings.Contact_MoTaForm
                </p>

                @if (ViewBag.Loi != null)
                {
                    <div class="sc-alert sc-alert-danger mb-3">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Loi</span>
                    </div>
                }

                @using (Html.BeginForm("LienHe", "Home", FormMethod.Post, new { id = "formLienHe" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="hoTen">@Resources.Strings.Contact_HoVaTen <span class="text-danger">*</span></label>
                            <input type="text" id="hoTen" name="hoTen" class="form-control" maxlength="100" required
                                   value="@ViewBag.HoTen" placeholder="@Resources.Strings.Contact_HoTenPlaceholder" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="soDienThoai">@Resources.Strings.Contact_SoDienThoai</label>
                            <input type="tel" id="soDienThoai" name="soDienThoai" class="form-control" maxlength="11"
                                   pattern="0[0-9]{9,10}" value="@ViewBag.SoDienThoai" placeholder="09xxxxxxxx" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="email">@Resources.Strings.Common_Email</label>
                            <input type="email" id="email" name="email" class="form-control" maxlength="150"
                                   value="@ViewBag.Email" placeholder="ban@email.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="noiDung">@Resources.Strings.Contact_NoiDung <span class="text-danger">*</span></label>
                            <textarea id="noiDung" name="noiDung" class="form-control" rows="4" minlength="10" maxlength="2000" required
                                      placeholder="@Resources.Strings.Contact_NoiDungPlaceholder">@ViewBag.NoiDung</textarea>
                            <small class="sc-text-muted">C&#7847;n &#237;t nh&#7845;t s&#7889; &#273;i&#7879;n tho&#7841;i ho&#7863;c email &#273;&#7875; ch&#250;ng t&#244;i li&#234;n h&#7879; l&#7841;i.</small>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-sc btn-lg">
                                <i class="bi bi-send"></i> @Resources.Strings.Contact_GuiLoiNhanBtn
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

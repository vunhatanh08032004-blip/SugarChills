@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model QL_MatHangAnUong.Models.GioHang
@{
    decimal tienGiam = ViewBag.TienGiam != null ? (decimal)ViewBag.TienGiam : 0;
    decimal phiGiao = ViewBag.PhiGiaoHang != null ? (decimal)ViewBag.PhiGiaoHang : 0;
    decimal tongTien = ViewBag.TongTien != null ? (decimal)ViewBag.TongTien : 0;
    decimal mucFreeship = ViewBag.MucMienPhiGiaoHang != null ? (decimal)ViewBag.MucMienPhiGiaoHang : 150000;
    var goiY = ViewBag.KhuyenMaiGoiY as List<KhuyenMai> ?? new List<KhuyenMai>();
}

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Common_GioHang</span>
    </div>

    <h2 class="mb-4">@Resources.Strings.Cart_GioHangCuaBan</h2>

    @if (Model.Items.Count == 0)
    {
        <div class="sc-panel sc-empty">
            <i class="bi bi-bag-heart"></i>
            <h5>@Resources.Strings.Cart_DangTrong</h5>
            <p>@Resources.Strings.Cart_ChonMonNgotMat</p>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc btn-lg">
                <i class="bi bi-cup-straw"></i> @Resources.Strings.About_XemThucDon
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- ============ DANH SÁCH MÓN TRONG GIỎ ============ -->
            <div class="col-lg-8">
                <div class="sc-panel">
                    <div class="table-responsive">
                        <table class="sc-cart-table">
                            <thead>
                                <tr>
                                    <th style="width:44%">@Resources.Strings.Cart_SanPham</th>
                                    <th class="text-center">@Resources.Strings.Cart_DonGia</th>
                                    <th class="text-center" style="width:170px">@Resources.Strings.Detail_SoLuong</th>
                                    <th class="text-end">@Resources.Strings.Cart_ThanhTien</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex gap-3">
                                                <img src="@item.HinhAnh" class="sc-cart-img" alt="@item.TenSP"
                                                     data-fallback="https://placehold.co/200x200/FFE6EE/E8517F?text=SC" />
                                                <div>
                                                    <a href="@Url.Action("ChiTiet", "SanPham", new { id = item.MaSP })"
                                                       class="fw-bold" style="color:var(--sc-brown)">@item.TenSP</a>
                                                    <div class="small sc-text-muted mt-1">@item.MoTaTuyChon</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-center">@DinhDang.Tien(item.DonGia)</td>

                                        <td class="text-center">
                                            @using (Html.BeginForm("CapNhat", "GioHang", FormMethod.Post))
                                            {
                                                <input type="hidden" name="khoa" value="@item.Khoa" />
                                                <div class="sc-qty">
                                                    <button type="button" data-buoc="giam">−</button>
                                                    <input type="number" name="soLuong" class="o-so-luong-gio"
                                                           value="@item.SoLuong" min="1" max="100" />
                                                    <button type="button" data-buoc="tang">+</button>
                                                </div>
                                            }
                                        </td>

                                        <td class="text-end fw-bold sc-text-primary">@DinhDang.Tien(item.ThanhTien)</td>

                                        <td class="text-end">
                                            @using (Html.BeginForm("Xoa", "GioHang", FormMethod.Post,
                                                new { @class = "can-xac-nhan", data_hoi = Resources.Strings.Cart_XoaMonNay }))
                                            {
                                                <input type="hidden" name="khoa" value="@item.Khoa" />
                                                <button type="submit" class="btn btn-sm btn-sc-soft" title="@Resources.Strings.Common_Xoa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                        <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc-outline">
                            <i class="bi bi-arrow-left"></i> @Resources.Strings.Cart_TiepTucChonMon
                        </a>

                        @using (Html.BeginForm("XoaTatCa", "GioHang", FormMethod.Post,
                            new { @class = "can-xac-nhan", data_hoi = Resources.Strings.Cart_XoaToanBoXacNhan }))
                        {
                            <button type="submit" class="btn btn-sc-soft">
                                <i class="bi bi-trash3"></i> @Resources.Strings.Cart_XoaToanBoGio
                            </button>
                        }
                    </div>
                </div>

                <!-- ---- Mã giảm giá ---- -->
                <div class="sc-panel mt-3">
                    <h5 class="mb-3"><i class="bi bi-ticket-perforated"></i> @Resources.Strings.Cart_MaGiamGia</h5>

                    @if (string.IsNullOrEmpty(Model.MaGiamGia))
                    {
                        using (Html.BeginForm("ApDungMa", "GioHang", FormMethod.Post, new { @class = "d-flex gap-2" }))
                        {
                            <input type="text" name="maGiamGia" class="form-control" placeholder="@Resources.Strings.Cart_NhapMaPlaceholder" />
                            <button type="submit" class="btn btn-sc text-nowrap">@Resources.Strings.SanPham_ApDung</button>
                        }

                        <div class="mt-3">
                            @foreach (var km in goiY)
                            {
                                using (Html.BeginForm("ApDungMa", "GioHang", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    <input type="hidden" name="maGiamGia" value="@km.MaGiamGia" />
                                    <button type="submit" class="sc-chip sc-chip-btn" title="@km.MoTa">
                                        <i class="bi bi-tag"></i> @km.MaGiamGia.ToUpper() — @(string.Format(Resources.Strings.Cart_GiamFormat, km.PhanTramGiam))
                                        @(km.LoaiGiam == QL_MatHangAnUong.Models.KhuyenMai.GiamPhiGiaoHang ? "phí ship" : "")
                                    </button>
                                }
                            }
                        </div>
                        <div class="small sc-text-muted mt-1">
                            <i class="bi bi-info-circle"></i> Bấm vào mã gợi ý để áp dụng ngay, hoặc nhập mã ở ô trên.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="sc-chip"><i class="bi bi-check-circle"></i> @(string.Format(Resources.Strings.Cart_DangDungMaFormat, Model.MaGiamGia.ToUpper()))</span>
                            @using (Html.BeginForm("BoMa", "GioHang", FormMethod.Post))
                            {
                                <button type="submit" class="btn btn-sm btn-sc-outline">@Resources.Strings.Cart_BoMa</button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ============ TÓM TẮT ĐƠN ============ -->
            <div class="col-lg-4">
                <div class="sc-summary">
                    <h5 class="mb-3">@Resources.Strings.Cart_TomTatDonHang</h5>

                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@(string.Format(Resources.Strings.Cart_TamTinhFormat, Model.TongSoLuong))</span>
                        <span>@DinhDang.Tien(Model.TamTinh)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Cart_GiamGia</span>
                        <span class="sc-text-primary">- @DinhDang.Tien(tienGiam)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Cart_PhiGiaoHang</span>
                        <span>@(phiGiao == 0 ? Resources.Strings.Cart_MienPhi : DinhDang.Tien(phiGiao))</span>
                    </div>

                    @if (Model.TamTinh < mucFreeship)
                    {
                        <div class="sc-alert sc-alert-info mt-2" style="font-size:13px">
                            <i class="bi bi-truck"></i>
                            @(string.Format(Resources.Strings.Cart_MuaThemFormat, DinhDang.Tien(mucFreeship - Model.TamTinh)))
                        </div>
                    }

                    <div class="sc-summary-total">
                        <span>@Resources.Strings.Cart_TongCong</span>
                        <span>@DinhDang.Tien(tongTien)</span>
                    </div>

                    <a href="@Url.Action("ThanhToan", "GioHang")" class="btn btn-sc btn-lg w-100 mt-3">
                        <i class="bi bi-bag-check"></i> @Resources.Strings.Cart_TienHanhDatHang
                    </a>

                    <div class="text-center small sc-text-muted mt-2">
                        @Resources.Strings.Cart_CanDangNhap
                    </div>
                </div>
            </div>
        </div>
    }
</div>

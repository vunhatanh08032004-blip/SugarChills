@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.ViewModels.DatHangViewModel

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("Index", "GioHang")">@Resources.Strings.Common_GioHang</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Checkout_DatHang</span>
    </div>

    <h2 class="mb-4">@Resources.Strings.Checkout_XacNhanDatHang</h2>

    @using (Html.BeginForm("ThanhToan", "GioHang", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.DaThanhToanQR, new { id = "DaThanhToanQR" })

        <div class="row g-4">
            <!-- ============ THÔNG TIN GIAO HÀNG ============ -->
            <div class="col-lg-7">
                <div class="sc-panel">
                    <h5 class="mb-3"><i class="bi bi-geo-alt"></i> @Resources.Strings.Checkout_ThongTinGiaoHang</h5>

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="TenNguoiNhan">@Resources.Strings.Checkout_TenNguoiNhan</label>
                            @Html.TextBoxFor(m => m.TenNguoiNhan, new { @class = "form-control", placeholder = Resources.Strings.Contact_HoTenPlaceholder })
                            @Html.ValidationMessageFor(m => m.TenNguoiNhan)
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="DienThoai">@Resources.Strings.Contact_SoDienThoai</label>
                            @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "09xxxxxxxx" })
                            @Html.ValidationMessageFor(m => m.DienThoai)
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Resources.Strings.Checkout_DiaChiGiaoHang</label>

                            @* DiaChi thật sự gửi lên server — được JS ghép từ Số nhà + Phường/Xã + Tỉnh/TP *@
                            @Html.HiddenFor(m => m.DiaChi, new { id = "DiaChi" })

                            <div id="khungChonDiaChi" class="row g-2">
                                <div class="col-md-6">
                                    <select id="selTinh" class="form-select" disabled>
                                        <option value="">Tỉnh / Thành phố</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select id="selPhuong" class="form-select" disabled>
                                        <option value="">Phường / Xã</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <input type="text" id="txtSoNha" class="form-control" maxlength="120"
                                           placeholder="Số nhà, tên đường (ví dụ: 12 Nguyễn Văn Bảo)" />
                                </div>
                            </div>

                            @* Dự phòng khi không tải được API (mất mạng...): cho gõ tay như cũ *@
                            <input type="text" id="txtDiaChiTuDo" class="form-control" maxlength="250" style="display:none"
                                   placeholder="@Resources.Strings.Checkout_DiaChiPlaceholder" />

                            <div class="small mt-2" id="xemTruocDiaChi" style="color:var(--sc-brown,#5a3a2e)"></div>
                            <div class="small text-danger mt-1" id="loiDiaChi" style="display:none"></div>
                            @Html.ValidationMessageFor(m => m.DiaChi)
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="GhiChu">@Resources.Strings.Checkout_GhiChuChoQuan</label>
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 3, placeholder = Resources.Strings.Checkout_GhiChuPlaceholder })
                            @Html.ValidationMessageFor(m => m.GhiChu)
                        </div>
                    </div>

                    <hr style="border-color:var(--sc-line)" />

                    <h5 class="mb-3"><i class="bi bi-credit-card"></i> @Resources.Strings.Checkout_HinhThucThanhToan</h5>
                    <label class="sc-topping">
                        @Html.RadioButtonFor(m => m.HinhThucThanhToan, "COD", new { id = "ttCOD" })
                        <span><strong>@Resources.Strings.Checkout_COD</strong><br />
                            <small class="sc-text-muted">@Resources.Strings.Checkout_CODMoTa</small></span>
                    </label>
                    <label class="sc-topping">
                        @Html.RadioButtonFor(m => m.HinhThucThanhToan, "QR", new { id = "ttQR" })
                        <span>
                            <strong>Thanh toán bằng mã QR</strong><br />
                            <small class="sc-text-muted">Quét mã VietQR để chuyển khoản đúng số tiền</small>
                        </span>
                    </label>
                    @Html.ValidationMessageFor(m => m.HinhThucThanhToan)

                    <div id="khungThanhToanQR" class="sc-panel mt-3 text-center" style="display:none;background:var(--sc-bg-soft,#fff7f9)">
                        <h6 class="mb-2"><i class="bi bi-qr-code"></i> Quét mã để thanh toán</h6>
                        <img id="anhMaQR" src="https://img.vietqr.io/image/970436-0123456789-compact2.png?amount=@((long)Model.TongTien)&addInfo=@Uri.EscapeDataString("SugarChills - " + Model.TenNguoiNhan)&accountName=SUGARCHILLS"
                             alt="Mã QR thanh toán SugarChills" style="width:220px;height:220px;border-radius:12px;border:1px solid var(--sc-line)" />
                        <div class="small sc-text-muted mt-2">
                            SugarChills - 0123456789 - Vietcombank<br />
                            Số tiền cần thanh toán: <strong id="soTienCanTT" data-goc="@DinhDang.Tien(Model.TongTien)">@DinhDang.Tien(Model.TongTien)</strong>
                        </div>
                        <div id="trangThaiQR" class="mt-2 fw-bold" style="color:var(--sc-primary,#E8517F)">
                            <i class="bi bi-hourglass-split"></i> Đang chờ xác nhận thanh toán... <span id="demNguocQR">10</span>s
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============ TÓM TẮT ĐƠN ============ -->
            <div class="col-lg-5">
                <div class="sc-summary">
                    <h5 class="mb-3">@Resources.Strings.Checkout_DonHangCuaBan</h5>

                    @foreach (var item in Model.GioHang.Items)
                    {
                        <div class="d-flex gap-2 mb-3">
                            <img src="@item.HinhAnh" class="sc-cart-img" style="width:56px;height:56px" alt="@item.TenSP"
                                 data-fallback="https://placehold.co/200x200/FFE6EE/E8517F?text=SC" />
                            <div class="flex-fill">
                                <div class="fw-bold" style="font-size:14px">@item.TenSP <span class="sc-text-muted">× @item.SoLuong</span></div>
                                <div class="small sc-text-muted">@item.MoTaTuyChon</div>
                            </div>
                            <div class="text-nowrap fw-bold">@DinhDang.Tien(item.ThanhTien)</div>
                        </div>
                    }

                    <hr style="border-color:var(--sc-line)" />

                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Detail_TamTinh</span>
                        <span>@DinhDang.Tien(Model.GioHang.TamTinh)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">
                            @Resources.Strings.Cart_GiamGia
                            @if (!string.IsNullOrEmpty(Model.GioHang.MaGiamGia))
                            {
                                <text>(@Model.GioHang.MaGiamGia.ToUpper())</text>
                            }
                        </span>
                        <span class="sc-text-primary">- @DinhDang.Tien(Model.TienGiam)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Cart_PhiGiaoHang</span>
                        <span>@(Model.PhiGiaoHang == 0 ? Resources.Strings.Cart_MienPhi : DinhDang.Tien(Model.PhiGiaoHang))</span>
                    </div>

                    <div class="sc-summary-total">
                        <span>@Resources.Strings.Checkout_TongThanhToan</span>
                        <span>@DinhDang.Tien(Model.TongTien)</span>
                    </div>

                    <button type="submit" id="btnXacNhanDatHang" class="btn btn-sc btn-lg w-100 mt-3">
                        <i class="bi bi-check2-circle"></i> @Resources.Strings.Checkout_XacNhanDatHang
                    </button>

                    <a href="@Url.Action("Index", "GioHang")" class="btn btn-sc-outline w-100 mt-2">
                        @Resources.Strings.Checkout_QuayLaiGioHang
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
    // Chọn Tỉnh/TP -> Phường/Xã bằng API công khai provinces.open-api.vn (v2: đơn vị hành chính 2 cấp, 34 tỉnh/thành)
    (function () {
        var API = "https://provinces.open-api.vn/api/v2/";
        var $dc = document.getElementById("DiaChi"),
            selT = document.getElementById("selTinh"), selP = document.getElementById("selPhuong"),
            soNha = document.getElementById("txtSoNha"), tuDo = document.getElementById("txtDiaChiTuDo"),
            khung = document.getElementById("khungChonDiaChi"),
            xem = document.getElementById("xemTruocDiaChi"), loi = document.getElementById("loiDiaChi");
        var daChon = false;   // true khi khách bắt đầu tự chọn -> ghi đè địa chỉ đã lưu

        function hienXemTruoc() { xem.innerHTML = $dc.value ? '<i class="bi bi-geo-alt-fill"></i> Giao tới: <b></b>' : ""; if ($dc.value) xem.querySelector("b").textContent = $dc.value; }
        function ghep() {
            var t = selT.selectedIndex > 0 ? selT.options[selT.selectedIndex].text : "";
            var p = selP.selectedIndex > 0 ? selP.options[selP.selectedIndex].text : "";
            var parts = [soNha.value.trim(), p, t].filter(function (x) { return x; });
            if (parts.length) { $dc.value = parts.join(", "); daChon = true; }
            hienXemTruoc();
        }
        function layJson(url) { return fetch(url).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); }
        function doDropdown(sel, ds, nhan) {
            sel.innerHTML = "";
            var o = document.createElement("option"); o.value = ""; o.textContent = nhan; sel.appendChild(o);
            ds.forEach(function (x) { var op = document.createElement("option"); op.value = x.code; op.textContent = x.name; sel.appendChild(op); });
            sel.disabled = ds.length === 0;
        }
        function dungTuDo() {   // API lỗi -> quay về ô gõ tay
            khung.style.display = "none"; tuDo.style.display = ""; tuDo.value = $dc.value;
            tuDo.addEventListener("input", function () { $dc.value = tuDo.value; hienXemTruoc(); });
        }

        hienXemTruoc();
        layJson(API).then(function (ds) {
            ds.sort(function (a, b) { return a.name.localeCompare(b.name, "vi"); });
            doDropdown(selT, ds, "Tỉnh / Thành phố");
        }).catch(dungTuDo);

        selT.addEventListener("change", function () {
            doDropdown(selP, [], "Phường / Xã");
            if (selT.value) {
                selP.innerHTML = '<option value="">Đang tải...</option>';
                layJson(API + "p/" + selT.value + "?depth=2").then(function (p) {
                    var ws = (p.wards || []).slice().sort(function (a, b) { return a.name.localeCompare(b.name, "vi"); });
                    doDropdown(selP, ws, "Phường / Xã");
                }).catch(function () { doDropdown(selP, [], "Không tải được — thử lại"); });
            }
            ghep();
        });
        selP.addEventListener("change", ghep);
        soNha.addEventListener("input", ghep);

        // Chặn gửi form nếu khách đang chọn dở (thiếu tỉnh / phường / số nhà)
        document.querySelector("form[action*='ThanhToan']").addEventListener("submit", function (e) {
            loi.style.display = "none";
            if (daChon && khung.style.display !== "none") {
                var thieu = !selT.value ? "Vui lòng chọn Tỉnh / Thành phố."
                          : !selP.value ? "Vui lòng chọn Phường / Xã."
                          : !soNha.value.trim() ? "Vui lòng nhập số nhà, tên đường." : "";
                if (thieu) { e.preventDefault(); loi.textContent = thieu; loi.style.display = ""; }
            }
        });
    })();
    </script>
}

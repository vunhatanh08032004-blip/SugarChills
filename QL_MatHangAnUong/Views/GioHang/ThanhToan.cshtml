@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.ViewModels.DatHangViewModel

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("Index", "GioHang")">@Resources.Strings.Common_GioHang</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Checkout_DatHang</span>
    </div>

    <h2 class="mb-4">@Resources.Strings.Checkout_XacNhanDatHang</h2>

    @using (Html.BeginForm("ThanhToan", "GioHang", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- ============ THÔNG TIN GIAO HÀNG ============ -->
            <div class="col-lg-7">
                <div class="sc-panel">
                    <h5 class="mb-3"><i class="bi bi-geo-alt"></i> @Resources.Strings.Checkout_ThongTinGiaoHang</h5>

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="TenNguoiNhan">@Resources.Strings.Checkout_TenNguoiNhan</label>
                            @Html.TextBoxFor(m => m.TenNguoiNhan, new { @class = "form-control", placeholder = Resources.Strings.Contact_HoTenPlaceholder })
                            @Html.ValidationMessageFor(m => m.TenNguoiNhan)
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="DienThoai">@Resources.Strings.Contact_SoDienThoai</label>
                            @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "09xxxxxxxx" })
                            @Html.ValidationMessageFor(m => m.DienThoai)
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="DiaChi">@Resources.Strings.Checkout_DiaChiGiaoHang</label>
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = Resources.Strings.Checkout_DiaChiPlaceholder })
                            @Html.ValidationMessageFor(m => m.DiaChi)
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="GhiChu">@Resources.Strings.Checkout_GhiChuChoQuan</label>
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 3, placeholder = Resources.Strings.Checkout_GhiChuPlaceholder })
                            @Html.ValidationMessageFor(m => m.GhiChu)
                        </div>
                    </div>

                    <hr style="border-color:var(--sc-line)" />

                    <h5 class="mb-3"><i class="bi bi-credit-card"></i> @Resources.Strings.Checkout_HinhThucThanhToan</h5>
                    <label class="sc-topping">
                        @Html.RadioButtonFor(m => m.HinhThucThanhToan, "COD", new { id = "ttCOD" })
                        <span><strong>@Resources.Strings.Checkout_COD</strong><br />
                            <small class="sc-text-muted">@Resources.Strings.Checkout_CODMoTa</small></span>
                    </label>
                    <label class="sc-topping">
                        @Html.RadioButtonFor(m => m.HinhThucThanhToan, "Chuyển khoản", new { id = "ttCK" })
                        <span><strong>@Resources.Strings.Checkout_ChuyenKhoan</strong><br />
                            <small class="sc-text-muted">SugarChills - 0123456789 - Vietcombank</small></span>
                    </label>
                    <label class="sc-topping">
                        @Html.RadioButtonFor(m => m.HinhThucThanhToan, "Ví MoMo", new { id = "ttMomo" })
                        <span><strong>@Resources.Strings.Checkout_ViMomo</strong><br />
                            <small class="sc-text-muted">@Resources.Strings.Checkout_ViMomoMoTa</small></span>
                    </label>
                    @Html.ValidationMessageFor(m => m.HinhThucThanhToan)
                </div>
            </div>

            <!-- ============ TÓM TẮT ĐƠN ============ -->
            <div class="col-lg-5">
                <div class="sc-summary">
                    <h5 class="mb-3">@Resources.Strings.Checkout_DonHangCuaBan</h5>

                    @foreach (var item in Model.GioHang.Items)
                    {
                        <div class="d-flex gap-2 mb-3">
                            <img src="@item.HinhAnh" class="sc-cart-img" style="width:56px;height:56px" alt="@item.TenSP"
                                 data-fallback="https://placehold.co/200x200/FFE6EE/E8517F?text=SC" />
                            <div class="flex-fill">
                                <div class="fw-bold" style="font-size:14px">@item.TenSP <span class="sc-text-muted">× @item.SoLuong</span></div>
                                <div class="small sc-text-muted">@item.MoTaTuyChon</div>
                            </div>
                            <div class="text-nowrap fw-bold">@DinhDang.Tien(item.ThanhTien)</div>
                        </div>
                    }

                    <hr style="border-color:var(--sc-line)" />

                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Detail_TamTinh</span>
                        <span>@DinhDang.Tien(Model.GioHang.TamTinh)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">
                            @Resources.Strings.Cart_GiamGia
                            @if (!string.IsNullOrEmpty(Model.GioHang.MaGiamGia))
                            {
                                <text>(@Model.GioHang.MaGiamGia.ToUpper())</text>
                            }
                        </span>
                        <span class="sc-text-primary">- @DinhDang.Tien(Model.TienGiam)</span>
                    </div>
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">@Resources.Strings.Cart_PhiGiaoHang</span>
                        <span>@(Model.PhiGiaoHang == 0 ? Resources.Strings.Cart_MienPhi : DinhDang.Tien(Model.PhiGiaoHang))</span>
                    </div>

                    <div class="sc-summary-total">
                        <span>@Resources.Strings.Checkout_TongThanhToan</span>
                        <span>@DinhDang.Tien(Model.TongTien)</span>
                    </div>

                    <button type="submit" class="btn btn-sc btn-lg w-100 mt-3">
                        <i class="bi bi-check2-circle"></i> @Resources.Strings.Checkout_XacNhanDatHang
                    </button>

                    <a href="@Url.Action("Index", "GioHang")" class="btn btn-sc-outline w-100 mt-2">
                        @Resources.Strings.Checkout_QuayLaiGioHang
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

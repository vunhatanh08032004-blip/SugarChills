@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.DonHang

<div class="container pb-5">
    <div class="sc-panel text-center mt-4" style="max-width:760px;margin:0 auto">
        <div class="sc-feature-icon mx-auto mb-3"
             style="width:76px;height:76px;font-size:34px;background:#E1F7F1;color:#2FA98A">
            <i class="bi bi-check-lg"></i>
        </div>

        <h2>@Resources.Strings.Success_DatHangThanhCong</h2>
        <p class="sc-text-muted">
            @Resources.Strings.Success_CamOnPrefix <strong>#@Model.MaDH</strong> @Resources.Strings.Success_CamOnSuffix
        </p>

        <div class="row g-3 text-start mt-3">
            <div class="col-md-6">
                <div class="sc-panel h-100" style="box-shadow:none;background:var(--sc-primary-softer)">
                    <div class="sc-option-title">@Resources.Strings.Success_NguoiNhan</div>
                    <div>@Model.TenNguoiNhan</div>
                    <div class="sc-text-muted">@Model.DienThoai</div>
                    <div class="sc-text-muted">@Model.DiaChi</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="sc-panel h-100" style="box-shadow:none;background:var(--sc-primary-softer)">
                    <div class="sc-option-title">@Resources.Strings.Success_DonHang</div>
                    <div>@(string.Format(Resources.Strings.Success_NgayDatFormat, DinhDang.NgayGio(Model.NgayDat)))</div>
                    <div>@(string.Format(Resources.Strings.Success_ThanhToanFormat, Model.HinhThucThanhToan))</div>
                    <div>
                        @if (Model.DaThanhToan)
                        {
                            <span class="sc-badge badge-success">Đã thanh toán</span>
                        }
                        else
                        {
                            <span>Còn phải thu: <strong>@DinhDang.Tien(Model.SoTienConLai)</strong></span>
                        }
                    </div>
                    <div>@Resources.Strings.Success_TrangThai <span class="sc-badge @Model.CssTrangThai">@Model.TrangThai</span></div>
                </div>
            </div>
        </div>

        <div class="table-responsive mt-4 text-start">
            <table class="table sc-table">
                <thead>
                    <tr>
                        <th>@Resources.Strings.Success_Mon</th>
                        <th class="text-center">@Resources.Strings.Success_SL</th>
                        <th class="text-end">@Resources.Strings.Cart_ThanhTien</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ct in Model.ChiTietDonHangs)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@ct.TenSP</div>
                                <div class="small sc-text-muted">@ct.TuyChon</div>
                            </td>
                            <td class="text-center">@ct.SoLuong</td>
                            <td class="text-end">@DinhDang.Tien(ct.ThanhTien)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end sc-text-muted">@Resources.Strings.Detail_TamTinh</td>
                        <td class="text-end">@DinhDang.Tien(Model.TamTinh)</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="text-end sc-text-muted">@Resources.Strings.Cart_GiamGia</td>
                        <td class="text-end">- @DinhDang.Tien(Model.TienGiam)</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="text-end sc-text-muted">@Resources.Strings.Cart_PhiGiaoHang</td>
                        <td class="text-end">@DinhDang.Tien(Model.PhiGiaoHang)</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="text-end fw-bold">@Resources.Strings.Cart_TongCong</td>
                        <td class="text-end fw-bold sc-text-primary" style="font-size:18px">@DinhDang.Tien(Model.TongTien)</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
            <a href="@Url.Action("ChiTiet", "DonHang", new { id = Model.MaDH })" class="btn btn-sc">
                <i class="bi bi-receipt"></i> @Resources.Strings.Success_TheoDoiDonHang
            </a>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc-outline">@Resources.Strings.Success_TiepTucMuaSam</a>
        </div>
    </div>
</div>

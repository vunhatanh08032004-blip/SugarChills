@model QL_MatHangAnUong.Models.ViewModels.DoiMatKhauViewModel

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("ThongTin")">Tài khoản của tôi</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>Đổi mật khẩu</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="sc-panel p-4 p-lg-5">
                <h4 class="mb-1">Đổi mật khẩu</h4>
                <p class="sc-text-muted small mb-4">Nhập mật khẩu hiện tại để xác nhận trước khi đổi.</p>

                @using (Html.BeginForm("DoiMatKhau", "TaiKhoan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="row g-3">
                        <div class="col-12">
                            @Html.LabelFor(m => m.MatKhauHienTai, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.MatKhauHienTai, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.MatKhauHienTai)
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.MatKhauMoi, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                            @Html.ValidationMessageFor(m => m.MatKhauMoi)
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.XacNhanMatKhauMoi, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.XacNhanMatKhauMoi, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới" })
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhauMoi)
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-sc">Đổi mật khẩu</button>
                        <a href="@Url.Action("ThongTin")" class="btn btn-sc-soft">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
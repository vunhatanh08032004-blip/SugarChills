@model QL_MatHangAnUong.Models.ViewModels.DangKyViewModel

<div class="container sc-auth-wrap">
    <div class="sc-auth-card w-100" style="max-width:980px;margin:0 auto">
        <div class="row g-0">
            <div class="col-lg-5 sc-auth-side">
                <h3>Tham gia SugarChills</h3>
                <p>Tạo tài khoản chỉ trong 30 giây để đặt món, lưu địa chỉ và nhận ưu đãi thành viên.</p>
                <img src="https://images.unsplash.com/photo-1558857563-b371033873b8?auto=format&fit=crop&w=600&q=80"
                     class="mt-4 d-none d-lg-block" style="border-radius:16px;max-height:200px;object-fit:cover;width:100%"
                     alt="SugarChills"
                     onerror="this.onerror=null;this.src='https://placehold.co/600x400/FFE6EE/E8517F?text=SugarChills';" />
            </div>

            <div class="col-lg-7 p-4 p-lg-5">
                <h4 class="mb-1">Đăng ký tài khoản</h4>
                <p class="sc-text-muted small mb-4">Đã có tài khoản?
                    <a href="@Url.Action("DangNhap")">Đăng nhập</a>
                </p>

                @using (Html.BeginForm("DangKy", "TaiKhoan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.HoTen, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                            @Html.ValidationMessageFor(m => m.HoTen)
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.DienThoai, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "09xxxxxxxx" })
                            @Html.ValidationMessageFor(m => m.DienThoai)
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ban@email.com" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.DiaChi, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Số nhà, đường, phường, quận" })
                            @Html.ValidationMessageFor(m => m.DiaChi)
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.MatKhau, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                            @Html.ValidationMessageFor(m => m.MatKhau)
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau)
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sc btn-lg w-100 mt-4">Tạo tài khoản</button>

                    <p class="small sc-text-muted text-center mt-3 mb-0">
                        Khi đăng ký, bạn đồng ý với điều khoản sử dụng của SugarChills.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

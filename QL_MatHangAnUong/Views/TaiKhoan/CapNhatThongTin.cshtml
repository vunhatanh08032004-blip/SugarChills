@model QL_MatHangAnUong.Models.ViewModels.CapNhatThongTinViewModel

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("ThongTin")">Tài khoản của tôi</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>Chỉnh sửa thông tin</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="sc-panel p-4 p-lg-5">
                <h4 class="mb-1">Chỉnh sửa thông tin cá nhân</h4>
                <p class="sc-text-muted small mb-4">
                    Đổi mật khẩu ở <a href="@Url.Action("DoiMatKhau")">trang riêng</a>.
                </p>

                @using (Html.BeginForm("CapNhatThongTin", "TaiKhoan", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaND)
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="row g-3">
                        <div class="col-12">
                            @Html.LabelFor(m => m.HoTen, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.HoTen)
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.DienThoai, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "09xxxxxxxx" })
                            @Html.ValidationMessageFor(m => m.DienThoai)
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.DiaChi, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Số nhà, đường, phường, quận" })
                            @Html.ValidationMessageFor(m => m.DiaChi)
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-sc">Lưu thay đổi</button>
                        <a href="@Url.Action("ThongTin")" class="btn btn-sc-soft">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
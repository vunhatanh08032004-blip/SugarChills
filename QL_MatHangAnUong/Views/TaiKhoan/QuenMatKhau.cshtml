@model QL_MatHangAnUong.Models.ViewModels.QuenMatKhauViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    int buoc = ViewBag.Buoc is int ? (int)ViewBag.Buoc : 1;
}

<div class="container sc-auth-wrap">
    <div class="sc-auth-card w-100" style="max-width:800px;margin:0 auto">
        <div class="row g-0">
            <div class="col-lg-5 sc-auth-side">
                <div style="font-size:52px;margin-bottom:16px;opacity:.9">🔑</div>
                <h3>Đặt lại mật khẩu</h3>
                <p>Chúng tôi gửi mã OTP 6 số về email đã đăng ký để xác minh đó là bạn.</p>
                <div class="mt-4 small">
                    <div class="mb-2"><i class="bi bi-envelope-check"></i> Bước 1: nhập email nhận mã</div>
                    <div class="mb-2"><i class="bi bi-shield-check"></i> Bước 2: nhập mã OTP</div>
                    <div class="mb-2"><i class="bi bi-lock"></i> Bước 3: đặt mật khẩu mới</div>
                    <div><i class="bi bi-clock"></i> Mã có hiệu lực 5 phút</div>
                </div>
            </div>

            <div class="col-lg-7 p-4 p-lg-5">
                <h4 class="mb-1">Quên mật khẩu?</h4>
                <p class="sc-text-muted small mb-4">
                    Đã nhớ lại? <a href="@Url.Action("DangNhap", "TaiKhoan")">Đăng nhập ngay</a>
                </p>

                @if (buoc == 1)
                {
                    using (Html.BeginForm("GuiMaOtp", "TaiKhoan", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="form-label" for="email">
                                <i class="bi bi-envelope me-1"></i>Email đăng ký
                            </label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="ban@email.com"
                                   autocomplete="email" required />
                        </div>
                        <button type="submit" class="btn btn-sc btn-lg w-100">
                            <i class="bi bi-send me-1"></i> Gửi mã OTP
                        </button>
                    }
                }
                else if (buoc == 2)
                {
                    using (Html.BeginForm("XacNhanOtp", "TaiKhoan", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <p class="small mb-3">Mã OTP đã gửi tới <b>@Model.Email</b>.
                           <a href="@Url.Action("DoiEmailQuenMatKhau", "TaiKhoan")">Đổi email / gửi lại mã</a></p>

                        <div class="mb-4">
                            <label class="form-label" for="otp">
                                <i class="bi bi-key me-1"></i>Mã OTP (6 số)
                            </label>
                            <input type="text" id="otp" name="otp" class="form-control" inputmode="numeric"
                                   maxlength="6" pattern="\d{6}" placeholder="123456" autocomplete="one-time-code" required autofocus />
                        </div>

                        <button type="submit" class="btn btn-sc btn-lg w-100">
                            <i class="bi bi-check2-circle me-1"></i> Xác nhận mã
                        </button>
                    }
                }
                else
                {
                    using (Html.BeginForm("QuenMatKhau", "TaiKhoan", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <div class="sc-alert sc-alert-success mb-3">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Đã xác minh <b>@Model.Email</b>. Hãy đặt mật khẩu mới.</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="MatKhauMoi">
                                <i class="bi bi-lock me-1"></i>Mật khẩu mới
                            </label>
                            @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control", placeholder = "Ít nhất 6 ký tự" })
                            @Html.ValidationMessageFor(m => m.MatKhauMoi)
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="XacNhanMatKhau">
                                <i class="bi bi-lock-fill me-1"></i>Xác nhận mật khẩu mới
                            </label>
                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới" })
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau)
                        </div>

                        @* Email bắt buộc theo ViewModel nhưng server luôn dùng email đã xác minh *@
                        <input type="hidden" name="Email" value="@Model.Email" />

                        <button type="submit" class="btn btn-sc btn-lg w-100">
                            <i class="bi bi-arrow-clockwise me-1"></i> Đặt lại mật khẩu
                        </button>
                    }
                }

                <div class="text-center mt-4">
                    <a href="@Url.Action("DangNhap", "TaiKhoan")" class="small sc-text-muted">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

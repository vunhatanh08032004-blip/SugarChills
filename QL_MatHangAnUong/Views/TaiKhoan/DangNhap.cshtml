@model QL_MatHangAnUong.Models.ViewModels.DangNhapViewModel

<div class="container sc-auth-wrap">
    <div class="sc-auth-card w-100" style="max-width:920px;margin:0 auto">
        <div class="row g-0">
            <div class="col-lg-5 sc-auth-side">
                <h3>@Resources.Strings.Auth_ChaoMungTroLai</h3>
                <p>@Resources.Strings.Auth_ChaoMungMoTa</p>
                <div class="mt-4 small">
                    <div class="mb-2"><i class="bi bi-check-circle"></i> @Resources.Strings.Auth_LuuDiaChi</div>
                    <div class="mb-2"><i class="bi bi-check-circle"></i> @Resources.Strings.Auth_TheoDoiTrangThai</div>
                    <div><i class="bi bi-check-circle"></i> @Resources.Strings.Auth_NhanMaGiamGia</div>
                </div>
            </div>

            <div class="col-lg-7 p-4 p-lg-5">
                <h4 class="mb-1">@Resources.Strings.Common_DangNhap</h4>
                <p class="sc-text-muted small mb-4">@Resources.Strings.Auth_ChuaCoTaiKhoan
                    <a href="@Url.Action("DangKy", new { returnUrl = ViewBag.ReturnUrl })">@Resources.Strings.Auth_DangKyNgay</a>
                </p>

                @using (Html.BeginForm("DangNhap", "TaiKhoan", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="mb-3">
                        <label class="form-label" for="Email">@Resources.Strings.Common_Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ban@email.com" })
                        @Html.ValidationMessageFor(m => m.Email)
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="MatKhau">@Resources.Strings.Auth_MatKhau</label>
                        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "••••••" })
                        @Html.ValidationMessageFor(m => m.MatKhau)
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="d-flex align-items-center gap-2 small">
                            @Html.CheckBoxFor(m => m.GhiNho)
                            <span>@Resources.Strings.Auth_GhiNhoDangNhap</span>
                        </label>
                        <a href="#" class="small">@Resources.Strings.Auth_QuenMatKhau</a>
                    </div>

                    <button type="submit" class="btn btn-sc btn-lg w-100">@Resources.Strings.Common_DangNhap</button>
                }

                <div class="sc-alert sc-alert-info mt-4" style="font-size:13px">
                    <i class="bi bi-info-circle"></i>
                    <div>
                        <strong>@Resources.Strings.Auth_TaiKhoanDungThu</strong><br />
                        @Resources.Strings.Seller_NguoiBan: seller@sugarchills.vn / 123456<br />
                        @Resources.Strings.Auth_KhachHang: khach@gmail.com / 123456
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

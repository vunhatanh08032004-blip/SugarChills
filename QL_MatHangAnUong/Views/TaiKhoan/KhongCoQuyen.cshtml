@{
    ViewBag.Title = Resources.Strings.Auth_KhongCoQuyenTruyCap;
}

<div class="container sc-auth-wrap">
    <div class="sc-panel text-center w-100" style="max-width:560px;margin:0 auto">
        <div class="sc-feature-icon mx-auto mb-3"
             style="width:76px;height:76px;font-size:34px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>@Resources.Strings.Auth_KhuVucNguoiBan</h3>
        <p class="sc-text-muted">
            @Html.Raw(string.Format(Resources.Strings.Auth_KhongCoQuyenMoTaFormat, "<strong>" + Resources.Strings.Auth_KhachHang + "</strong>"))
        </p>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <a href="@Url.Action("Index", "Home")" class="btn btn-sc">@Resources.Strings.Auth_VeTrangChu</a>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc-outline">@Resources.Strings.About_XemThucDon</a>
        </div>
    </div>
</div>

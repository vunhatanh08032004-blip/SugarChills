@{
    ViewBag.Title = "Không có quyền truy cập";
}

<div class="container sc-auth-wrap">
    <div class="sc-panel text-center w-100" style="max-width:560px;margin:0 auto">
        <div class="sc-feature-icon mx-auto mb-3"
             style="width:76px;height:76px;font-size:34px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>Khu vực dành riêng cho người bán</h3>
        <p class="sc-text-muted">
            Tài khoản của bạn đang đăng nhập với vai trò <strong>Khách hàng</strong> nên không thể vào
            trang quản trị. Nếu bạn là chủ shop, hãy đăng nhập bằng tài khoản người bán.
        </p>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <a href="@Url.Action("Index", "Home")" class="btn btn-sc">Về trang chủ</a>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc-outline">Xem thực đơn</a>
        </div>
    </div>
</div>

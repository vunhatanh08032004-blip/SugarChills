@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model List<QL_MatHangAnUong.Models.DonHang>
@{
    string dangChon = ViewBag.TrangThaiDangChon as string ?? "Tất cả";
}

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>@Resources.Strings.Header_DonHangCuaToi</span>
    </div>

    <h2 class="mb-3">@Resources.Strings.Header_DonHangCuaToi</h2>

    <!-- Lọc theo trạng thái -->
    <div class="mb-4">
        <a href="@Url.Action("Index")" class="sc-chip @(dangChon == "Tất cả" ? "" : "")"
           style="@(dangChon == "Tất cả" ? "background:var(--sc-primary);color:#fff" : "")">@Resources.Strings.Common_TatCa</a>
        @foreach (var tt in DonHang.CacTrangThai)
        {
            <a href="@Url.Action("Index", new { trangThai = tt })" class="sc-chip"
               style="@(dangChon == tt ? "background:var(--sc-primary);color:#fff" : "")">@tt</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="sc-panel sc-empty">
            <i class="bi bi-receipt"></i>
            <h5>@Resources.Strings.Order_ChuaCoDonHang</h5>
            <p>@Resources.Strings.Order_KhiBanDatMon</p>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-sc">@Resources.Strings.Order_DatMonNgay</a>
        </div>
    }
    else
    {
        foreach (var dh in Model)
        {
            <div class="sc-panel mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <span class="fw-bold" style="font-size:17px;color:var(--sc-brown)">@(string.Format(Resources.Strings.Order_DonFormat, dh.MaDH))</span>
                        <span class="sc-text-muted small ms-2">@DinhDang.NgayGio(dh.NgayDat)</span>
                    </div>
                    <span class="sc-badge @dh.CssTrangThai">@dh.TrangThai</span>
                </div>

                <div class="row g-2">
                    @foreach (var ct in dh.ChiTietDonHangs.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="d-flex gap-2 align-items-center">
                                <div class="sc-feature-icon" style="width:38px;height:38px;flex:0 0 38px;font-size:15px">
                                    <i class="bi bi-cup-straw"></i>
                                </div>
                                <div class="small">
                                    <div class="fw-bold">@ct.TenSP</div>
                                    <div class="sc-text-muted">× @ct.SoLuong — @DinhDang.Tien(ct.ThanhTien)</div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (dh.ChiTietDonHangs.Count > 3)
                    {
                        <div class="col-12 small sc-text-muted">@(string.Format(Resources.Strings.Order_VaMonKhacFormat, dh.ChiTietDonHangs.Count - 3))</div>
                    }
                </div>

                <hr style="border-color:var(--sc-line)" />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="sc-text-muted">@Resources.Strings.Order_TongTien</span>
                        <span class="fw-bold sc-text-primary" style="font-size:18px">@DinhDang.Tien(dh.TongTien)</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("ChiTiet", new { id = dh.MaDH })" class="btn btn-sc-soft btn-sm">
                            <i class="bi bi-eye"></i> @Resources.Strings.Order_XemChiTiet
                        </a>
                        @if (dh.TrangThai == DonHang.ChoXacNhan)
                        {
                            using (Html.BeginForm("HuyDon", "DonHang", FormMethod.Post,
                                new { @class = "can-xac-nhan d-inline", data_hoi = Resources.Strings.Order_XacNhanHuyDon }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@dh.MaDH" />
                                <button type="submit" class="btn btn-sc-outline btn-sm">@Resources.Strings.Order_HuyDon</button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

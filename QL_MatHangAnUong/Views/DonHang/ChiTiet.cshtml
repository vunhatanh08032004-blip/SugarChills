@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model QL_MatHangAnUong.Models.DonHang
@{
    // Xác định bước hiện tại trên thanh tiến trình
    var cacBuoc = new[] { DonHang.ChoXacNhan, DonHang.DaXacNhan, DonHang.DangGiao, DonHang.HoanThanh };
    int buocHienTai = Array.IndexOf(cacBuoc, Model.TrangThai);
    bool daHuy = Model.TrangThai == DonHang.DaHuy;
}

<div class="container pb-5">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("Index", "DonHang")">@Resources.Strings.Header_DonHangCuaToi</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span>#@Model.MaDH</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="sc-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h4 class="mb-0">@(string.Format(Resources.Strings.Order_DonFormat, Model.MaDH))</h4>
                    <span class="sc-badge @Model.CssTrangThai">@Model.TrangThai</span>
                </div>
                <div class="sc-text-muted small mt-1">@(string.Format(Resources.Strings.Order_DatLucFormat, DinhDang.NgayGio(Model.NgayDat)))</div>

                @if (daHuy)
                {
                    <div class="sc-alert sc-alert-danger mt-3">
                        <i class="bi bi-x-circle"></i> @Resources.Strings.Order_DaBiHuy
                    </div>
                }
                else
                {
                    <div class="sc-timeline mt-4">
                        @for (int i = 0; i < cacBuoc.Length; i++)
                        {
                            <div class="sc-timeline-step @(i <= buocHienTai ? "done" : "")">@cacBuoc[i]</div>
                        }
                    </div>
                }

                <hr style="border-color:var(--sc-line)" />

                <div class="table-responsive">
                    <table class="table sc-table">
                        <thead>
                            <tr>
                                <th>@Resources.Strings.Success_Mon</th>
                                <th class="text-center">@Resources.Strings.Cart_DonGia</th>
                                <th class="text-center">@Resources.Strings.Success_SL</th>
                                <th class="text-end">@Resources.Strings.Cart_ThanhTien</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTietDonHangs)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("ChiTiet", "SanPham", new { id = ct.MaSP })" class="fw-bold">@ct.TenSP</a>
                                        <div class="small sc-text-muted">@ct.TuyChon</div>
                                    </td>
                                    <td class="text-center">@DinhDang.Tien(ct.DonGia)</td>
                                    <td class="text-center">@ct.SoLuong</td>
                                    <td class="text-end fw-bold">@DinhDang.Tien(ct.ThanhTien)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sc-summary">
                <h5 class="mb-3">@Resources.Strings.Checkout_ThongTinGiaoHang</h5>
                <div class="mb-1"><strong>@Model.TenNguoiNhan</strong></div>
                <div class="sc-text-muted">@Model.DienThoai</div>
                <div class="sc-text-muted">@Model.DiaChi</div>
                @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                {
                    <div class="mt-2 small"><em>@(string.Format(Resources.Strings.Order_GhiChuFormat, Model.GhiChu))</em></div>
                }

                <hr style="border-color:var(--sc-line)" />

                <div class="sc-summary-row">
                    <span class="sc-text-muted">@Resources.Strings.Detail_TamTinh</span>
                    <span>@DinhDang.Tien(Model.TamTinh)</span>
                </div>
                <div class="sc-summary-row">
                    <span class="sc-text-muted">@Resources.Strings.Cart_GiamGia</span>
                    <span class="sc-text-primary">- @DinhDang.Tien(Model.TienGiam)</span>
                </div>
                <div class="sc-summary-row">
                    <span class="sc-text-muted">@Resources.Strings.Cart_PhiGiaoHang</span>
                    <span>@DinhDang.Tien(Model.PhiGiaoHang)</span>
                </div>
                <div class="sc-summary-row">
                    <span class="sc-text-muted">@Resources.Strings.Order_ThanhToanLabel</span>
                    <span>
                        @Model.HinhThucThanhToan
                        @if (Model.DaThanhToan)
                        {
                            <span class="sc-badge badge-success ms-1">Đã thanh toán</span>
                        }
                    </span>
                </div>
                @if (!Model.DaThanhToan)
                {
                    <div class="sc-summary-row">
                        <span class="sc-text-muted">Còn phải thu</span>
                        <span>@DinhDang.Tien(Model.SoTienConLai)</span>
                    </div>
                }

                <div class="sc-summary-total">
                    <span>@Resources.Strings.Cart_TongCong</span>
                    <span>@DinhDang.Tien(Model.TongTien)</span>
                </div>

                @if (Model.TrangThai == DonHang.ChoXacNhan)
                {
                    using (Html.BeginForm("HuyDon", "DonHang", FormMethod.Post,
                        new { @class = "can-xac-nhan", data_hoi = Resources.Strings.Order_XacNhanHuyDon }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.MaDH" />
                        <button type="submit" class="btn btn-sc-outline w-100 mt-3">@Resources.Strings.Order_HuyDonHangBtn</button>
                    }
                }

                <a href="@Url.Action("Index", "DonHang")" class="btn btn-sc-soft w-100 mt-2">@Resources.Strings.Order_VeDanhSachDon</a>
            </div>
        </div>
    </div>
</div>

@model QL_MatHangAnUong.Models.LienLac
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
}

<div class="sc-table-card" style="max-width:760px">
    <div class="sc-table-head">
        <div>
            <h5>@Model.HoTen</h5>
            <small class="sc-text-muted"><i class="bi bi-clock"></i> Gửi lúc @Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-sm btn-sc-outline"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="p-3">
        <div class="d-flex flex-wrap gap-4 mb-3">
            <div>
                <small class="sc-text-muted d-block">Số điện thoại</small>
                @if (string.IsNullOrEmpty(Model.SoDienThoai)) { <span class="sc-text-muted">—</span> }
                else { <a href="tel:@Model.SoDienThoai">@Model.SoDienThoai</a> }
            </div>
            <div>
                <small class="sc-text-muted d-block">Email</small>
                @if (string.IsNullOrEmpty(Model.Email)) { <span class="sc-text-muted">—</span> }
                else { <a href="mailto:@Model.Email">@Model.Email</a> }
            </div>
        </div>

        <small class="sc-text-muted d-block mb-1">Nội dung</small>
        <div class="p-3 rounded" style="background:#fdf6f9;white-space:pre-wrap">@Model.NoiDung</div>

        <div class="d-flex gap-2 mt-3">
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <a href="mailto:@Model.Email?subject=SugarChills%20ph%E1%BA%A3n%20h%E1%BB%93i" class="btn btn-sc"><i class="bi bi-reply"></i> Trả lời qua email</a>
            }
            @using (Html.BeginForm("Xoa", "QuanLyLienLac", FormMethod.Post,
                new { onsubmit = "return confirm('Xóa tin nhắn này? Không thể khôi phục.');" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaLienLac" />
                <button type="submit" class="btn btn-sc-outline"><i class="bi bi-trash"></i> Xóa</button>
            }
        </div>
    </div>
</div>

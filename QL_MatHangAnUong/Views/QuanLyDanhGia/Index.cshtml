@using QL_MatHangAnUong.Helpers
@model List<QL_MatHangAnUong.Controllers.DanhGiaQuanTriDong>
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Đánh giá sản phẩm";
    string tuKhoa = ViewBag.TuKhoa as string;
    int? soSao = ViewBag.SoSao as int?;
    int[] soTheoSao = ViewBag.SoTheoSao as int[] ?? new int[6];
    int tongSo = ViewBag.TongSo ?? 0;
    double trungBinh = ViewBag.TrungBinh ?? 0.0;
    int trangHienTai = ViewBag.TrangHienTai ?? 1;
}

<div class="sc-table-card">
    <div class="sc-table-head">
        <div>
            <h5>Đánh giá của khách hàng</h5>
            <small class="sc-text-muted">
                Tổng @tongSo đánh giá
                @if (tongSo > 0)
                {
                    <span> — điểm trung bình <strong class="sc-text-primary">@trungBinh.ToString("0.0")</strong>/5 <i class="bi bi-star-fill text-warning"></i></span>
                }
            </small>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            @using (Html.BeginForm("Index", "QuanLyDanhGia", FormMethod.Get, new { @class = "d-flex gap-2" }))
            {
                if (soSao.HasValue)
                {
                    <input type="hidden" name="soSao" value="@soSao.Value" />
                }
                <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control form-control-sm" style="width:210px"
                       placeholder="Tìm tên món hoặc khách..." />
                <button type="submit" class="btn btn-sm btn-sc"><i class="bi bi-search"></i></button>
            }

            <div class="btn-group">
                <a href="@Url.Action("Index", new { tuKhoa = tuKhoa })" class="btn btn-sm @(!soSao.HasValue ? "btn-sc" : "btn-sc-outline")">Tất cả</a>
                @for (int s = 5; s >= 1; s--)
                {
                    <a href="@Url.Action("Index", new { tuKhoa = tuKhoa, soSao = s })"
                       class="btn btn-sm @(soSao == s ? "btn-sc" : "btn-sc-outline")" title="@s sao">@s <i class="bi bi-star-fill"></i> (@soTheoSao[s])</a>
                }
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table sc-table align-middle">
            <thead>
                <tr>
                    <th style="width:60px">#</th>
                    <th style="width:200px">Món</th>
                    <th style="width:190px">Khách hàng</th>
                    <th style="width:120px">Số sao</th>
                    <th>Nhận xét</th>
                    <th style="width:140px">Ngày</th>
                    <th class="text-end" style="width:110px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-5 sc-text-muted"><i class="bi bi-chat-square-heart"></i> Chưa có đánh giá nào.</td></tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.MaDG</td>
                            <td>
                                <a href="@Url.Action("ChiTiet", "SanPham", new { id = t.MaSP })" target="_blank" class="fw-semibold text-reset">@t.TenSP</a>
                            </td>
                            <td>
                                <div>@t.HoTen</div>
                                <small class="sc-text-muted">@t.Email</small>
                            </td>
                            <td class="text-nowrap">
                                <span class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= t.SoSao ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(t.NoiDung))
                                {
                                    <span class="sc-text-muted">(không có nhận xét)</span>
                                }
                                else
                                {
                                    <span style="white-space:pre-line">@t.NoiDung</span>
                                }
                            </td>
                            <td><small>@DinhDang.NgayGio(t.NgayDanh)</small></td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("ChiTiet", "SanPham", new { id = t.MaSP })#khungDanhGia" target="_blank" class="btn btn-sm btn-sc-soft" title="Xem trên website"><i class="bi bi-eye"></i></a>
                                @using (Html.BeginForm("Xoa", "QuanLyDanhGia", FormMethod.Post,
                                    new { @class = "d-inline", onsubmit = "return confirm('Xóa đánh giá này? Khách sẽ được đánh giá lại món này. Không thể khôi phục.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.MaDG" />
                                    <input type="hidden" name="tuKhoa" value="@tuKhoa" />
                                    if (soSao.HasValue)
                                    {
                                        <input type="hidden" name="soSao" value="@soSao.Value" />
                                    }
                                    <input type="hidden" name="trang" value="@trangHienTai" />
                                    <button type="submit" class="btn btn-sm btn-sc-outline" title="Xóa"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @Html.Partial("_PhanTrang")
</div>

@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.ViewModels.DanhSachSanPhamViewModel
@{
    var soSPTheoLoai = ViewBag.SoSanPhamTheoLoai as Dictionary<int, int> ?? new Dictionary<int, int>();

    // Sidebar lọc theo loại: ẩn khi vào từ lối tắt "Xem thêm" ở trang chủ và chưa chọn
    // danh mục nào (Model.HienBoLoc do controller quyết định). Các link Sắp xếp / Lọc
    // nhanh / phân trang bên dưới không mang theo cờ "an" nữa nên một khi sidebar đã
    // hiện, nó luôn giữ hiện khi khách đổi sắp xếp hoặc lọc bán chạy, giảm giá...
    bool hienBoLoc = Model.HienBoLoc;

    // Hàm nhỏ giúp giữ nguyên các tham số lọc khi bấm sang trang khác
    Func<int, object> thamSoTrang = t => new
    {
        tuKhoa = Model.TuKhoa,
        maLoai = Model.MaLoai,
        giaTu = Model.GiaTu,
        giaDen = Model.GiaDen,
        sapXep = Model.SapXep,
        trang = t
    };
}

<div class="container">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">@Resources.Strings.Common_TrangChu</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        @if (!string.IsNullOrEmpty(Model.TieuDeTrang))
        {
            <span>@Model.TieuDeTrang</span>
        }
        else
        {
            <span>@Resources.Strings.Header_ThucDon</span>
            if (!string.IsNullOrEmpty(Model.TenLoaiDangChon))
            {
                <i class="bi bi-chevron-right" style="font-size:11px"></i>
                <span class="sc-text-primary fw-bold">@Model.TenLoaiDangChon</span>
            }
        }
    </div>

    <div class="row g-4 pb-5">

        <!-- ============ CỘT BỘ LỌC (rubric 3.3 - lọc theo loại) — chỉ hiện khi duyệt theo Danh mục ============ -->
        @if (hienBoLoc)
        {
            <div class="col-lg-3">
                <div class="sc-filter">
                    <h6><i class="bi bi-funnel"></i> @Resources.Strings.SanPham_LoaiSanPham</h6>
                    <div class="sc-filter-list">
                        <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, sapXep = Model.SapXep })"
                           class="@(Model.MaLoai == null ? "active" : "")">
                            <span>@Resources.Strings.Common_TatCa</span>
                            <span class="sc-count">@Model.TongSoSanPham</span>
                        </a>
                        @foreach (var loai in Model.DanhSachLoai)
                        {
                            <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, maLoai = loai.MaLoai, sapXep = Model.SapXep })"
                               class="@(Model.MaLoai == loai.MaLoai ? "active" : "")">
                                <span>@loai.TenLoai</span>
                                <span class="sc-count">@(soSPTheoLoai.ContainsKey(loai.MaLoai) ? soSPTheoLoai[loai.MaLoai] : 0)</span>
                            </a>
                        }
                    </div>

                    <h6><i class="bi bi-cash-coin"></i> @Resources.Strings.SanPham_KhoangGia</h6>
                    <form method="get" action="@Url.Action("Index")">
                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                        <input type="hidden" name="maLoai" value="@Model.MaLoai" />
                        <input type="hidden" name="sapXep" value="@Model.SapXep" />
                        <div class="d-flex gap-2 mb-2">
                            <input type="number" class="form-control" name="giaTu" placeholder="@Resources.Strings.SanPham_Tu" min="0" step="1000" value="@Model.GiaTu" />
                            <input type="number" class="form-control" name="giaDen" placeholder="@Resources.Strings.SanPham_Den" min="0" step="1000" value="@Model.GiaDen" />
                        </div>
                        <button type="submit" class="btn btn-sc w-100 btn-sm">@Resources.Strings.SanPham_ApDung</button>
                    </form>

                    <h6><i class="bi bi-lightning"></i> @Resources.Strings.SanPham_LocNhanh</h6>
                    <div>
                        <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, maLoai = Model.MaLoai, sapXep = Model.SapXep, giaDen = 35000 })" class="sc-chip">@Resources.Strings.SanPham_Duoi35k</a>
                        <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, maLoai = Model.MaLoai, sapXep = Model.SapXep, giaTu = 35000, giaDen = 50000 })" class="sc-chip">@Resources.Strings.SanPham_35kTo50k</a>
                        <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, maLoai = Model.MaLoai, sapXep = Model.SapXep, giaTu = 50000 })" class="sc-chip">@Resources.Strings.SanPham_Tren50k</a>
                        <a href="@Url.Action("Index", new { tuKhoa = Model.TuKhoa, maLoai = Model.MaLoai, giaTu = Model.GiaTu, giaDen = Model.GiaDen, sapXep = "ban-chay" })" class="sc-chip"><i class="bi bi-fire"></i> @Resources.Strings.SanPham_BanChay</a>
                    </div>
                </div>
            </div>
        }

        <!-- ============ CỘT DANH SÁCH SẢN PHẨM ============ -->
        <div class="@(hienBoLoc ? "col-lg-9" : "col-lg-12")">
            <div class="sc-section-head">
                <div>
                    <h2>
                        @if (!string.IsNullOrWhiteSpace(Model.TuKhoa))
                        {
                            @(string.Format(Resources.Strings.SanPham_KetQuaChoFormat, Model.TuKhoa))
                        }
                        else if (!string.IsNullOrEmpty(Model.TieuDeTrang))
                        {
                            @Model.TieuDeTrang
                        }
                        else if (!string.IsNullOrEmpty(Model.TenLoaiDangChon))
                        {
                            @Model.TenLoaiDangChon
                        }
                        else
                        {
                            @Resources.Strings.SanPham_ToanBoThucDon
                        }
                    </h2>
                    <div class="sc-sub">@Resources.Strings.SanPham_TimThayPrefix <strong>@Model.TongSoSanPham</strong> @Resources.Strings.SanPham_SanPhamSuffix</div>
                </div>

                @if (hienBoLoc)
                {
                    <form method="get" action="@Url.Action("Index")" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                        <input type="hidden" name="maLoai" value="@Model.MaLoai" />
                        <input type="hidden" name="giaTu" value="@Model.GiaTu" />
                        <input type="hidden" name="giaDen" value="@Model.GiaDen" />
                        <label class="form-label mb-0 text-nowrap">@Resources.Strings.SanPham_SapXep</label>
                        <select name="sapXep" class="form-select" onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.SapXep))">@Resources.Strings.SanPham_MacDinh</option>
                            <option value="ban-chay" selected="@(Model.SapXep == "ban-chay")">@Resources.Strings.SanPham_BanChay</option>
                            <option value="gia-tang" selected="@(Model.SapXep == "gia-tang")">@Resources.Strings.SanPham_GiaTangDan</option>
                            <option value="gia-giam" selected="@(Model.SapXep == "gia-giam")">@Resources.Strings.SanPham_GiaGiamDan</option>
                            <option value="ten" selected="@(Model.SapXep == "ten")">@Resources.Strings.SanPham_TenAZ</option>
                        </select>
                    </form>
                }
            </div>

            @if (Model.SanPhams.Count == 0)
            {
                <div class="sc-panel sc-empty">
                    <i class="bi bi-cup-straw"></i>
                    <h5>@Resources.Strings.SanPham_KhongTimThay</h5>
                    <p>@Resources.Strings.SanPham_DoiTuKhoa</p>
                    <a href="@Url.Action("Index")" class="btn btn-sc">@Resources.Strings.SanPham_XemTatCaSanPham</a>
                </div>
            }
            else
            {
                <div class="row g-3 g-lg-4">
                    @foreach (var sp in Model.SanPhams)
                    {
                        <div class="@(hienBoLoc ? "col-6 col-md-4" : "col-6 col-md-4 col-lg-3")">
                            @Html.Partial("_CardSanPham", sp)
                        </div>
                    }
                </div>

                if (Model.TongSoTrang > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.TrangHienTai == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", thamSoTrang(Model.TrangHienTai - 1))">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TongSoTrang; i++)
                            {
                                <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", thamSoTrang(i))">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.TrangHienTai == Model.TongSoTrang ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", thamSoTrang(Model.TrangHienTai + 1))">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

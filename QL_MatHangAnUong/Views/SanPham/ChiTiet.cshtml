@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model QL_MatHangAnUong.Models.ViewModels.ChiTietSanPhamViewModel
@{
    var sp = Model.SanPham;
}

<div class="container">
    <div class="sc-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <a href="@Url.Action("Index", "SanPham")">Thực đơn</a>
        @if (sp.LoaiSanPham != null)
        {
            <i class="bi bi-chevron-right" style="font-size:11px"></i>
            <a href="@Url.Action("Index", "SanPham", new { maLoai = sp.MaLoai })">@sp.LoaiSanPham.TenLoai</a>
        }
        <i class="bi bi-chevron-right" style="font-size:11px"></i>
        <span class="sc-text-primary fw-bold">@sp.TenSP</span>
    </div>

    <!-- ============ THÔNG TIN SẢN PHẨM ============ -->
    <div class="sc-panel">
        @using (Html.BeginForm("Them", "GioHang", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="maSP" value="@sp.MaSP" />

            <div class="row g-4" id="khungTuyChon" data-gia-goc="@sp.GiaBanThucTe">
                <div class="col-lg-5">
                    <div class="position-relative">
                        @if (sp.PhanTramGiam > 0)
                        {
                            <span class="sc-badge-sale" style="font-size:14px">-@sp.PhanTramGiam%</span>
                        }
                        <img src="@sp.HinhAnh" class="sc-detail-img" alt="@sp.TenSP"
                             onerror="this.onerror=null;this.src='https://placehold.co/800x800/FFE6EE/E8517F?text=SugarChills';" />
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="sc-product-cat">
                        @(sp.LoaiSanPham != null ? sp.LoaiSanPham.TenLoai : "SugarChills")
                    </div>
                    <h1 style="font-size:30px">@sp.TenSP</h1>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="text-warning">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                        </span>
                        <span class="sc-text-muted small">Đã bán @sp.LuotBan ly</span>
                        @if (sp.SoLuongTon > 0)
                        {
                            <span class="sc-badge badge-success">Còn hàng</span>
                        }
                        else
                        {
                            <span class="sc-badge badge-danger">Tạm hết</span>
                        }
                    </div>

                    <div class="mb-3">
                        <span class="sc-price-lg">@DinhDang.Tien(sp.GiaBanThucTe)</span>
                        @if (sp.PhanTramGiam > 0)
                        {
                            <span class="sc-price-old" style="font-size:18px">@DinhDang.Tien(sp.Gia)</span>
                        }
                    </div>

                    <p class="sc-text-muted">@sp.MoTa</p>

                    <hr style="border-color:var(--sc-line)" />

                    <!-- ---- Tùy chọn SIZE (radio) ---- -->
                    <div class="mb-3">
                        <div class="sc-option-title">Chọn size</div>
                        <div class="sc-pill-group">
                            @foreach (var size in TuyChonSanPham.CacSize)
                            {
                                decimal phuThu = TuyChonSanPham.PhuThuSize(size);
                                <label class="sc-pill">
                                    <input type="radio" name="size" value="@size" data-phu-thu="@phuThu"
                                           checked="@(size == "M")" />
                                    <span>
                                        Size @size
                                        @if (phuThu > 0)
                                        {
                                            <text> (+@DinhDang.Tien(phuThu))</text>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- ---- Mức đường (radio) ---- -->
                        <div class="col-md-6">
                            <div class="sc-option-title">Mức đường</div>
                            <div class="sc-pill-group">
                                @foreach (var muc in TuyChonSanPham.CacMucDuong)
                                {
                                    <label class="sc-pill">
                                        <input type="radio" name="duong" value="@muc" checked="@(muc == "100%")" />
                                        <span>@muc</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- ---- Mức đá (radio) ---- -->
                        <div class="col-md-6">
                            <div class="sc-option-title">Mức đá</div>
                            <div class="sc-pill-group">
                                @foreach (var muc in TuyChonSanPham.CacMucDa)
                                {
                                    <label class="sc-pill">
                                        <input type="radio" name="da" value="@muc" checked="@(muc == "100%")" />
                                        <span>@muc</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ---- Topping (checkbox) ---- -->
                    <div class="mb-3">
                        <div class="sc-option-title">Topping thêm</div>
                        <div class="row g-2">
                            @foreach (var tp in TuyChonSanPham.CacTopping)
                            {
                                <div class="col-md-6">
                                    <label class="sc-topping">
                                        <input type="checkbox" name="toppings" value="@tp.Key" data-phu-thu="@tp.Value" />
                                        <span>@tp.Key</span>
                                        <span class="sc-topping-price">+@DinhDang.Tien(tp.Value)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ---- Số lượng + nút mua ---- -->
                    <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                        <div>
                            <div class="sc-option-title">Số lượng</div>
                            <div class="sc-qty">
                                <button type="button" data-buoc="giam">−</button>
                                <input type="number" name="soLuong" id="SoLuongMua" value="1" min="1" max="100" />
                                <button type="button" data-buoc="tang">+</button>
                            </div>
                        </div>

                        <div class="ms-auto text-end">
                            <div class="sc-text-muted small">Tạm tính</div>
                            <div class="sc-price-lg" id="tamTinhChiTiet">@DinhDang.Tien(sp.GiaBanThucTe)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-sc btn-lg flex-fill" @(sp.SoLuongTon > 0 ? "" : "disabled")>
                            <i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng
                        </button>
                        <a href="@Url.Action("Index", "GioHang")" class="btn btn-sc-outline btn-lg">
                            <i class="bi bi-bag-heart"></i> Xem giỏ
                        </a>
                    </div>

                    <div class="mt-3 small sc-text-muted">
                        <i class="bi bi-truck"></i> Giao trong 30 phút &nbsp;•&nbsp;
                        <i class="bi bi-shield-check"></i> Đổi ly mới nếu sai món &nbsp;•&nbsp;
                        <i class="bi bi-telephone"></i> 1900 6789
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ============ MÔ TẢ CHI TIẾT (thông tin bổ sung) ============ -->
    <div class="sc-panel mt-4">
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabMoTa" type="button">Mô tả</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDinhDuong" type="button">Thông tin thêm</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabGiaoHang" type="button">Giao hàng</button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabMoTa">
                <p>@sp.MoTa</p>
                <p class="sc-text-muted mb-0">
                    Món được pha chế sau khi bạn đặt, trà ủ mới mỗi 4 tiếng. Bạn có thể chọn mức đường và đá
                    phù hợp khẩu vị, thêm topping tùy thích ở phần tùy chọn phía trên.
                </p>
            </div>
            <div class="tab-pane fade" id="tabDinhDuong">
                <table class="table sc-table">
                    <tbody>
                        <tr><th style="width:220px">Mã sản phẩm</th><td>SC@(sp.MaSP.ToString("D3"))</td></tr>
                        <tr><th>Loại</th><td>@(sp.LoaiSanPham != null ? sp.LoaiSanPham.TenLoai : "-")</td></tr>
                        <tr><th>Giá niêm yết</th><td>@DinhDang.Tien(sp.Gia)</td></tr>
                        <tr><th>Tình trạng</th><td>@(sp.SoLuongTon > 0 ? "Còn hàng" : "Tạm hết")</td></tr>
                        <tr><th>Đã bán</th><td>@sp.LuotBan ly</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="tab-pane fade" id="tabGiaoHang">
                <ul class="mb-0 sc-text-muted">
                    <li>Giao trong bán kính 5km, thời gian trung bình 30 phút.</li>
                    <li>Phí giao hàng 15.000đ, miễn phí cho đơn từ 150.000đ.</li>
                    <li>Thanh toán khi nhận hàng (COD) hoặc chuyển khoản.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ============ SẢN PHẨM LIÊN QUAN (rubric 4.4) ============ -->
    @if (Model.SanPhamLienQuan.Count > 0)
    {
        <section class="sc-section">
            <div class="sc-section-head">
                <div>
                    <h2>Có thể bạn cũng thích</h2>
                    <div class="sc-sub">Cùng nhóm @(sp.LoaiSanPham != null ? sp.LoaiSanPham.TenLoai.ToLower() : "sản phẩm")</div>
                </div>
                <a href="@Url.Action("Index", "SanPham", new { maLoai = sp.MaLoai })" class="btn btn-sc-soft">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row g-3 g-lg-4">
                @foreach (var lq in Model.SanPhamLienQuan)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @Html.Partial("_CardSanPham", lq)
                    </div>
                }
            </div>
        </section>
    }
</div>

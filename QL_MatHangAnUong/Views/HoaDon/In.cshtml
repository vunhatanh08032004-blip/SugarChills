@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model QL_MatHangAnUong.Models.DonHang
@{
    Layout = null;   // Hóa đơn là trang độc lập, không dùng layout của website
    bool daHuy = Model.TrangThai == DonHang.DaHuy;
    int stt = 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hóa đơn HD@(Model.MaDH.ToString("D6")) - SugarChills</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f6f1f3; color: #2b2326; font: 14px/1.5 "Segoe UI", Arial, sans-serif; }
        .toolbar { max-width: 780px; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; padding: 0 12px; }
        .toolbar button, .toolbar a { border: 0; border-radius: 8px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }
        .btn-in { background: #e8517f; color: #fff; }
        .btn-phu { background: #fff; color: #e8517f; border: 1px solid #e8517f !important; }
        .hd { position: relative; max-width: 780px; margin: 12px auto 32px; background: #fff; padding: 32px 36px; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
        .hd-head { display: flex; justify-content: space-between; gap: 16px; border-bottom: 2px solid #e8517f; padding-bottom: 14px; }
        .brand { font-size: 28px; font-weight: 800; color: #e8517f; letter-spacing: .5px; }
        .muted { color: #7a6a70; }
        .hd-title { text-align: right; }
        .hd-title h1 { margin: 0; font-size: 22px; letter-spacing: 1px; }
        .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 18px 0; }
        .box { border: 1px solid #f0d3dc; border-radius: 8px; padding: 10px 14px; }
        .box h3 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; color: #e8517f; letter-spacing: .6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 4px; }
        th { background: #fdeef3; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; }
        th, td { padding: 8px 10px; border-bottom: 1px solid #f3e4e9; vertical-align: top; }
        .r { text-align: right; } .c { text-align: center; }
        .opt { font-size: 12px; color: #7a6a70; }
        .tong { width: 300px; margin: 14px 0 0 auto; }
        .tong div { display: flex; justify-content: space-between; padding: 3px 0; }
        .tong .total { border-top: 2px solid #2b2326; margin-top: 6px; padding-top: 8px; font-size: 18px; font-weight: 800; }
        .tag { display: inline-block; border: 1px solid #2e9e5b; color: #2e9e5b; border-radius: 99px; padding: 0 10px; font-size: 12px; font-weight: 600; }
        .tag.warn { border-color: #d98a00; color: #d98a00; }
        .huy { position: absolute; top: 120px; left: 50%; transform: translateX(-50%) rotate(-12deg); font-size: 48px; font-weight: 800; color: rgba(214,40,57,.22); border: 6px solid rgba(214,40,57,.22); padding: 0 18px; pointer-events: none; }
        .ky { display: flex; justify-content: space-around; margin-top: 36px; text-align: center; }
        .ky div { width: 40%; }
        .ky .line { height: 64px; }
        .cam-on { text-align: center; margin-top: 22px; color: #7a6a70; font-size: 13px; }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none !important; }
            .hd { margin: 0; max-width: none; box-shadow: none; border-radius: 0; padding: 0; }
            @@page { margin: 14mm; }
        }
        @@media (max-width: 600px) { .grid2 { grid-template-columns: 1fr; } .hd { padding: 20px 16px; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn-in" onclick="window.print()">In hóa đơn</button>
        <a class="btn-phu" href="javascript:window.close()">Đóng</a>
    </div>

    <div class="hd">
        @if (daHuy)
        {
            <div class="huy">ĐÃ HỦY</div>
        }

        <div class="hd-head">
            <div>
                <div class="brand">SugarChills</div>
                <div class="muted">Trà sữa • Cà phê • Kem • Bánh ngọt</div>
                <div class="muted">Hotline: 1900 6789</div>
            </div>
            <div class="hd-title">
                <h1>HÓA ĐƠN BÁN HÀNG</h1>
                <div>Số: <strong>HD@(Model.MaDH.ToString("D6"))</strong></div>
                <div class="muted">Ngày đặt: @DinhDang.NgayGio(Model.NgayDat)</div>
            </div>
        </div>

        <div class="grid2">
            <div class="box">
                <h3>Thông tin giao hàng</h3>
                <div><strong>@Model.TenNguoiNhan</strong></div>
                <div>@Model.DienThoai</div>
                <div>@Model.DiaChi</div>
                @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                {
                    <div class="opt">Ghi chú: @Model.GhiChu</div>
                }
            </div>
            <div class="box">
                <h3>Thanh toán</h3>
                <div>Hình thức: <strong>@Model.HinhThucThanhToan</strong></div>
                <div>Trạng thái đơn: <strong>@Model.TrangThai</strong></div>
                <div>
                    @if (Model.DaThanhToan)
                    {
                        <span class="tag">Đã thanh toán</span>
                    }
                    else
                    {
                        <span class="tag warn">Chưa thanh toán</span>
                    }
                </div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width:36px">#</th>
                    <th>Món</th>
                    <th class="r">Đơn giá</th>
                    <th class="c">SL</th>
                    <th class="r">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ct in Model.ChiTietDonHangs)
                {
                    stt++;
                    <tr>
                        <td>@stt</td>
                        <td>
                            @ct.TenSP
                            @if (!string.IsNullOrWhiteSpace(ct.TuyChon))
                            {
                                <div class="opt">@ct.TuyChon</div>
                            }
                        </td>
                        <td class="r">@DinhDang.Tien(ct.DonGia)</td>
                        <td class="c">@ct.SoLuong</td>
                        <td class="r"><strong>@DinhDang.Tien(ct.ThanhTien)</strong></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="tong">
            <div><span class="muted">Tạm tính</span><span>@DinhDang.Tien(Model.TamTinh)</span></div>
            <div>
                <span class="muted">Giảm giá@(string.IsNullOrWhiteSpace(Model.MaGiamGiaApDung) ? "" : " (" + Model.MaGiamGiaApDung + ")")</span>
                <span>- @DinhDang.Tien(Model.TienGiam)</span>
            </div>
            <div><span class="muted">Phí giao hàng</span><span>@DinhDang.Tien(Model.PhiGiaoHang)</span></div>
            <div class="total"><span>TỔNG CỘNG</span><span>@DinhDang.Tien(Model.TongTien)</span></div>
            @if (!Model.DaThanhToan && !daHuy)
            {
                <div><span class="muted">Còn phải thu</span><span><strong>@DinhDang.Tien(Model.SoTienConLai)</strong></span></div>
            }
        </div>

        <div class="ky">
            <div><strong>Khách hàng</strong><div class="muted">(Ký, ghi rõ họ tên)</div><div class="line"></div></div>
            <div><strong>Người bán</strong><div class="muted">(Ký, ghi rõ họ tên)</div><div class="line"></div></div>
        </div>

        <div class="cam-on">Cảm ơn quý khách đã ủng hộ SugarChills!</div>
    </div>

    @if (ViewBag.TuDongIn == true)
    {
        <script>
            window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
        </script>
    }
</body>
</html>

@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model List<QL_MatHangAnUong.Models.SanPham>
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Quản lý sản phẩm";

    var dsLoai = ViewBag.DanhSachLoai as List<LoaiSanPham> ?? new List<LoaiSanPham>();
    int? maLoaiChon = ViewBag.MaLoai as int?;
    string trangThaiChon = ViewBag.TrangThai as string;
}

<div class="sc-table-card">
    <div class="sc-table-head">
        <div>
            <h5>Danh sách sản phẩm</h5>
            <small class="sc-text-muted">Tổng cộng @Model.Count sản phẩm</small>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form method="get" action="@Url.Action("Index")" class="d-flex flex-wrap gap-2">
                <input type="text" name="tuKhoa" class="form-control" style="min-width:200px"
                       placeholder="Tìm theo tên sản phẩm..." value="@ViewBag.TuKhoa" />

                <select name="maLoai" class="form-select" style="min-width:160px">
                    <option value="">-- Tất cả loại --</option>
                    @foreach (var l in dsLoai)
                    {
                        <option value="@l.MaLoai" selected="@(maLoaiChon == l.MaLoai)">@l.TenLoai</option>
                    }
                </select>

                <select name="trangThai" class="form-select" style="min-width:150px">
                    <option value="">-- Trạng thái --</option>
                    <option value="dang-ban" selected="@(trangThaiChon == "dang-ban")">Đang bán</option>
                    <option value="ngung-ban" selected="@(trangThaiChon == "ngung-ban")">Ngừng bán</option>
                </select>

                <button type="submit" class="btn btn-sc-soft"><i class="bi bi-search"></i></button>
            </form>

            <a href="@Url.Action("Them")" class="btn btn-sc text-nowrap">
                <i class="bi bi-plus-lg"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table sc-table align-middle">
            <thead>
                <tr>
                    <th style="width:70px">Mã</th>
                    <th>Sản phẩm</th>
                    <th>Loại</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Tồn</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Nổi bật</th>
                    <th class="text-end" style="width:170px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 sc-text-muted">
                            <i class="bi bi-inbox" style="font-size:34px;display:block"></i>
                            Không tìm thấy sản phẩm nào.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var sp in Model)
                    {
                        <tr>
                            <td class="fw-bold">SC@(sp.MaSP.ToString("D3"))</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@sp.HinhAnh" class="sc-thumb" alt="@sp.TenSP"
                                         onerror="this.onerror=null;this.src='https://placehold.co/100x100/FFE6EE/E8517F?text=SC';" />
                                    <div>
                                        <div class="fw-bold">@sp.TenSP</div>
                                        <div class="sc-text-muted" style="font-size:12px">Đã bán @sp.LuotBan</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(sp.LoaiSanPham != null ? sp.LoaiSanPham.TenLoai : "-")</td>
                            <td class="text-end">
                                <div class="fw-bold sc-text-primary">@DinhDang.Tien(sp.GiaBanThucTe)</div>
                                @if (sp.PhanTramGiam > 0)
                                {
                                    <div class="sc-price-old" style="margin:0">@DinhDang.Tien(sp.Gia)</div>
                                }
                            </td>
                            <td class="text-center">@sp.SoLuongTon</td>
                            <td class="text-center">
                                @if (sp.DangBan)
                                {
                                    <span class="sc-badge badge-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="sc-badge badge-muted">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (sp.NoiBat)
                                {
                                    <i class="bi bi-star-fill" style="color:var(--sc-yellow)"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star sc-text-muted"></i>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("ChiTiet", new { id = sp.MaSP })" class="btn btn-sm btn-sc-soft" title="Xem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Sua", new { id = sp.MaSP })" class="btn btn-sm btn-sc-soft" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("Xoa", new { id = sp.MaSP })" class="btn btn-sm btn-sc-outline" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model List<QL_MatHangAnUong.Models.SanPham>
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = Resources.Strings.Seller_QuanLySanPham;

    var dsLoai = ViewBag.DanhSachLoai as List<LoaiSanPham> ?? new List<LoaiSanPham>();
    int? maLoaiChon = ViewBag.MaLoai as int?;
    string trangThaiChon = ViewBag.TrangThai as string;
}

<div class="sc-table-card">
    <div class="sc-table-head">
        <div>
            <h5>@Resources.Strings.SellerProd_DanhSach</h5>
            <small class="sc-text-muted">@(string.Format(Resources.Strings.SellerProd_TongCongFormat, Model.Count))</small>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-start">
            <form method="get" action="@Url.Action("Index")" class="d-flex flex-wrap gap-2">
                <input type="text" name="tuKhoa" class="form-control" style="min-width:200px"
                       placeholder="@Resources.Strings.SellerProd_TimTheoTenPlaceholder" value="@ViewBag.TuKhoa" />

                <select name="maLoai" class="form-select" style="min-width:160px">
                    <option value="">@Resources.Strings.SellerProd_TatCaLoai</option>
                    @foreach (var l in dsLoai)
                    {
                        <option value="@l.MaLoai" selected="@(maLoaiChon == l.MaLoai)">@l.TenLoai</option>
                    }
                </select>

                <select name="trangThai" class="form-select" style="min-width:150px">
                    <option value="">@Resources.Strings.SellerProd_TatCaTrangThai</option>
                    <option value="dang-ban" selected="@(trangThaiChon == "dang-ban")">@Resources.Strings.SellerProd_DangBan</option>
                    <option value="ngung-ban" selected="@(trangThaiChon == "ngung-ban")">@Resources.Strings.SellerProd_NgungBan</option>
                </select>

                <button type="submit" class="btn btn-sc-soft"><i class="bi bi-search"></i></button>
            </form>

            <a href="@Url.Action("Them")" class="btn btn-sc text-nowrap">
                <i class="bi bi-plus-lg"></i> @Resources.Strings.SellerProd_ThemTitle
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table sc-table align-middle">
            <thead>
                <tr>
                    <th style="width:70px">@Resources.Strings.SellerProd_ColMa</th>
                    <th>@Resources.Strings.SellerProd_ColSanPham</th>
                    <th>@Resources.Strings.SellerProd_ColLoai</th>
                    <th class="text-end">@Resources.Strings.SellerProd_ColGiaBan</th>
                    <th class="text-center">@Resources.Strings.SellerProd_ColTon</th>
                    <th class="text-center">@Resources.Strings.Account_TrangThai</th>
                    <th class="text-center">@Resources.Strings.SellerProd_ColNoiBat</th>
                    <th class="text-end" style="width:170px">@Resources.Strings.Admin_ThaoTac</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 sc-text-muted">
                            <i class="bi bi-inbox" style="font-size:34px;display:block"></i>
                            @Resources.Strings.SellerProd_KhongTimThaySanPhamNao
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var sp in Model)
                    {
                        <tr>
                            <td class="fw-bold">SC@(sp.MaSP.ToString("D3"))</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@sp.HinhAnh" class="sc-thumb" alt="@sp.TenSP"
                                         data-fallback="https://placehold.co/100x100/FFE6EE/E8517F?text=SC" />
                                    <div>
                                        <div class="fw-bold">@sp.TenSP</div>
                                        <div class="sc-text-muted" style="font-size:12px">@(string.Format(Resources.Strings.SellerProd_DaBanFormat, sp.LuotBan))</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(sp.LoaiSanPham != null ? sp.LoaiSanPham.TenLoai : "-")</td>
                            <td class="text-end">
                                <div class="fw-bold sc-text-primary">@DinhDang.Tien(sp.GiaBanThucTe)</div>
                                @if (sp.PhanTramGiam > 0)
                                {
                                    <div class="sc-price-old" style="margin:0">@DinhDang.Tien(sp.Gia)</div>
                                }
                            </td>
                            <td class="text-center">@sp.SoLuongTon</td>
                            <td class="text-center">
                                @if (sp.DangBan)
                                {
                                    <span class="sc-badge badge-success">@Resources.Strings.SellerProd_DangBan</span>
                                }
                                else
                                {
                                    <span class="sc-badge badge-muted">@Resources.Strings.SellerProd_NgungBan</span>
                                }
                            </td>
                            <td class="text-center">
                                @using (Html.BeginForm("DoiNoiBat", "QuanLySanPham", new { id = sp.MaSP }, FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="sc-star-toggle"
                                            title="@(sp.NoiBat ? Resources.Strings.SellerProd_BoDanhDauNoiBat : Resources.Strings.SellerProd_DanhDauNoiBat)">
                                        @if (sp.NoiBat)
                                        {
                                            <i class="bi bi-star-fill" style="color:var(--sc-yellow)"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star sc-text-muted"></i>
                                        }
                                    </button>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("ChiTiet", new { id = sp.MaSP })" class="btn btn-sm btn-sc-soft" title="@Resources.Strings.Admin_Xem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Sua", new { id = sp.MaSP })" class="btn btn-sm btn-sc-soft" title="@Resources.Strings.Admin_Sua">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("Xoa", new { id = sp.MaSP })" class="btn btn-sm btn-sc-outline" title="@Resources.Strings.Common_Xoa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

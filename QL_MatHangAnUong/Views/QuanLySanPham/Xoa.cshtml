@using QL_MatHangAnUong.Helpers
@model QL_MatHangAnUong.Models.SanPham
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = Resources.Strings.SellerProd_XoaTitle;
}

<div class="sc-panel" style="max-width:640px;margin:0 auto">
    <div class="text-center mb-3">
        <div class="sc-feature-icon mx-auto mb-2"
             style="width:66px;height:66px;font-size:28px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h4>@Resources.Strings.SellerProd_XacNhanXoaHeading</h4>
        <p class="sc-text-muted">@Resources.Strings.Admin_KhongTheHoanTac @Resources.Strings.SellerProd_XacNhanXoaMoTa</p>
    </div>

    <div class="d-flex gap-3 align-items-center p-3" style="background:var(--sc-primary-softer);border-radius:14px">
        <img src="@Model.HinhAnh" class="sc-thumb" style="width:80px;height:80px" alt="@Model.TenSP"
             onerror="this.onerror=null;this.src='https://placehold.co/200x200/FFE6EE/E8517F?text=SC';" />
        <div>
            <div class="fw-bold" style="font-size:17px">@Model.TenSP</div>
            <div class="sc-text-muted small">
                @(Model.LoaiSanPham != null ? Model.LoaiSanPham.TenLoai : "-") •
                @DinhDang.Tien(Model.GiaBanThucTe) • @(string.Format(Resources.Strings.SellerProd_TonFormat, Model.SoLuongTon))
            </div>
        </div>
    </div>

    <div class="sc-alert sc-alert-warning mt-3">
        <i class="bi bi-lightbulb"></i>
        <span>@Html.Raw(string.Format(Resources.Strings.SellerProd_GoiYNgungBanFormat, "<strong>" + Resources.Strings.SellerProd_NgungBan + "</strong>"))</span>
    </div>

    <div class="d-flex gap-2 mt-3">
        @using (Html.BeginForm("XacNhanXoa", "QuanLySanPham", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaSP" />
            <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-trash"></i> @Resources.Strings.Admin_XacNhanXoa</button>
        }
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">@Resources.Strings.Admin_QuayLai</a>
    </div>
</div>

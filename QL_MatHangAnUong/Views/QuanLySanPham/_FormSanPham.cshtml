@model QL_MatHangAnUong.Models.SanPham
@*
    Partial dùng chung cho màn Thêm và Sửa sản phẩm.
    Có đủ: nhập hình (URL + xem trước), chọn loại (dropdown),
    radio trạng thái và checkbox nổi bật — đáp ứng rubric mục 6.
*@
@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
@Html.HiddenFor(m => m.MaSP)
@Html.HiddenFor(m => m.LuotBan)

<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc-panel">
            <h5 class="mb-3">@Resources.Strings.SellerProd_ThongTinSP</h5>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" for="TenSP">@Resources.Strings.SellerProd_TenSPLabel</label>
                    @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control", placeholder = Resources.Strings.SellerProd_TenSPPlaceholder })
                    @Html.ValidationMessageFor(m => m.TenSP)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="MaLoai">@Resources.Strings.SellerProd_LoaiSanPhamLabel</label>
                    @Html.DropDownListFor(m => m.MaLoai, (SelectList)ViewBag.DanhSachLoai,
                        Resources.Strings.SellerProd_ChonLoaiOption, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.MaLoai)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="SoLuongTon">@Resources.Strings.SellerProd_SoLuongTonLabel</label>
                    @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", type = "number", min = 0 })
                    @Html.ValidationMessageFor(m => m.SoLuongTon)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="Gia">@Resources.Strings.SellerProd_GiaBanLabel</label>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", min = 0, step = 1000 })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.Gia)
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="GiaKhuyenMai">@Resources.Strings.SellerProd_GiaKhuyenMaiLabel</label>
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.GiaKhuyenMai, new { @class = "form-control", type = "number", min = 0, step = 1000, placeholder = Resources.Strings.SellerProd_GiaKMPlaceholder })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.GiaKhuyenMai)
                </div>

                <div class="col-12">
                    <label class="form-label" for="MoTa">@Resources.Strings.SellerProd_MoTaLabel</label>
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 4, placeholder = Resources.Strings.SellerProd_MoTaPlaceholder })
                    @Html.ValidationMessageFor(m => m.MoTa)
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc-panel mb-3">
            <h5 class="mb-3">@Resources.Strings.SellerProd_HinhAnhHeading</h5>
            <img id="xemTruocAnh"
                 src="@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "https://placehold.co/300x300/FFE6EE/E8517F?text=SugarChills" : Model.HinhAnh)"
                 class="w-100 mb-2" style="border-radius:14px;aspect-ratio:1/1;object-fit:cover"
                 data-fallback="https://placehold.co/300x300/FFE6EE/E8517F?text=SugarChills" />

            <label class="form-label" for="HinhAnh">@Resources.Strings.SellerProd_HinhAnhHeading</label>
            @Html.TextBoxFor(m => m.HinhAnh, new { @class = "form-control", id = "HinhAnh", placeholder = Resources.Strings.SellerProd_HinhAnhPlaceholder })
            <small class="sc-text-muted">@Resources.Strings.SellerProd_HinhAnhHint</small>
        </div>

        <div class="sc-panel">
            <h5 class="mb-3">@Resources.Strings.SellerProd_HienThiHeading</h5>

            <!-- Radio: trạng thái bán -->
            <div class="sc-option-title">@Resources.Strings.SellerProd_TrangThaiBanLabel</div>
            <label class="sc-topping">
                @Html.RadioButtonFor(m => m.DangBan, true, new { id = "DangBanTrue" })
                <span>@Resources.Strings.SellerProd_DangBan</span>
            </label>
            <label class="sc-topping">
                @Html.RadioButtonFor(m => m.DangBan, false, new { id = "DangBanFalse" })
                <span>@Resources.Strings.SellerProd_NgungBan</span>
            </label>

            <!-- Checkbox: sản phẩm nổi bật -->
            <div class="sc-option-title mt-3">@Resources.Strings.SellerProd_TuyChonKhac</div>
            <label class="sc-topping">
                @Html.CheckBoxFor(m => m.NoiBat)
                <span>@Resources.Strings.SellerProd_HienThiMonNoiBat</span>
            </label>
        </div>
    </div>
</div>

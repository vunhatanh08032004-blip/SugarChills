@model QL_MatHangAnUong.Models.SanPham
@*
    Partial dùng chung cho màn Thêm và Sửa sản phẩm.
    Có đủ: nhập hình (URL + xem trước), chọn loại (dropdown),
    radio trạng thái và checkbox nổi bật — đáp ứng rubric mục 6.
*@
@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
@Html.HiddenFor(m => m.MaSP)
@Html.HiddenFor(m => m.LuotBan)

<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc-panel">
            <h5 class="mb-3">Thông tin sản phẩm</h5>

            <div class="row g-3">
                <div class="col-12">
                    @Html.LabelFor(m => m.TenSP, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control", placeholder = "Ví dụ: Trà sữa trân châu đường đen" })
                    @Html.ValidationMessageFor(m => m.TenSP)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.MaLoai, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.MaLoai, (SelectList)ViewBag.DanhSachLoai,
                        "-- Chọn loại sản phẩm --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.MaLoai)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.SoLuongTon, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", type = "number", min = 0 })
                    @Html.ValidationMessageFor(m => m.SoLuongTon)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Gia, new { @class = "form-label" })
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", min = 0, step = 1000 })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.Gia)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.GiaKhuyenMai, new { @class = "form-label" })
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.GiaKhuyenMai, new { @class = "form-control", type = "number", min = 0, step = 1000, placeholder = "Bỏ trống nếu không giảm giá" })
                        <span class="input-group-text">đ</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.GiaKhuyenMai)
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.MoTa, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 4, placeholder = "Mô tả ngắn về hương vị, nguyên liệu..." })
                    @Html.ValidationMessageFor(m => m.MoTa)
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc-panel mb-3">
            <h5 class="mb-3">Hình ảnh</h5>
            <img id="xemTruocAnh"
                 src="@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "https://placehold.co/300x300/FFE6EE/E8517F?text=SugarChills" : Model.HinhAnh)"
                 class="w-100 mb-2" style="border-radius:14px;aspect-ratio:1/1;object-fit:cover"
                 onerror="this.onerror=null;this.src='https://placehold.co/300x300/FFE6EE/E8517F?text=SugarChills';" />

            @Html.LabelFor(m => m.HinhAnh, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.HinhAnh, new { @class = "form-control", id = "HinhAnh", placeholder = "Dán link ảnh (https://...)" })
            <small class="sc-text-muted">Dán URL ảnh, khung xem trước sẽ tự cập nhật.</small>
        </div>

        <div class="sc-panel">
            <h5 class="mb-3">Hiển thị</h5>

            <!-- Radio: trạng thái bán -->
            <div class="sc-option-title">Trạng thái bán</div>
            <label class="sc-topping">
                @Html.RadioButtonFor(m => m.DangBan, true, new { id = "DangBanTrue" })
                <span>Đang bán</span>
            </label>
            <label class="sc-topping">
                @Html.RadioButtonFor(m => m.DangBan, false, new { id = "DangBanFalse" })
                <span>Ngừng bán</span>
            </label>

            <!-- Checkbox: sản phẩm nổi bật -->
            <div class="sc-option-title mt-3">Tùy chọn khác</div>
            <label class="sc-topping">
                @Html.CheckBoxFor(m => m.NoiBat)
                <span>Hiển thị ở mục "Món nổi bật" trang chủ</span>
            </label>
        </div>
    </div>
</div>

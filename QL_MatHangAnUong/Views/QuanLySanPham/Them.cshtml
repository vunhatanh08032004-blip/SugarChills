@model QL_MatHangAnUong.Models.SanPham
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Thêm sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm sản phẩm mới</h4>
    <a href="@Url.Action("Index")" class="btn btn-sc-soft"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

@using (Html.BeginForm("Them", "QuanLySanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_FormSanPham", Model)

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-save"></i> Lưu sản phẩm</button>
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Hủy</a>
    </div>
}

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

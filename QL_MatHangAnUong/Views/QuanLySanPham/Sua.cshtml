@model QL_MatHangAnUong.Models.SanPham
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Sửa sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa sản phẩm SC@(Model.MaSP.ToString("D3"))</h4>
    <a href="@Url.Action("Index")" class="btn btn-sc-soft"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

@using (Html.BeginForm("Sua", "QuanLySanPham", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_FormSanPham", Model)

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-save"></i> Cập nhật</button>
        <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Hủy</a>
        <a href="@Url.Action("Xoa", new { id = Model.MaSP })" class="btn btn-sc-soft btn-lg ms-auto">
            <i class="bi bi-trash"></i> Xóa sản phẩm
        </a>
    </div>
}

@section scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}

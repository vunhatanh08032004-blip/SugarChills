@model QL_MatHangAnUong.Models.LoaiSanPham
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Xóa loại sản phẩm";

    int soSP = ViewBag.SoSanPham != null ? (int)ViewBag.SoSanPham : 0;
}

<div class="sc-panel" style="max-width:620px;margin:0 auto">
    <div class="text-center mb-3">
        <div class="sc-feature-icon mx-auto mb-2"
             style="width:66px;height:66px;font-size:28px;background:#FFECF1;color:#C0345C">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h4>Xác nhận xóa loại sản phẩm</h4>
    </div>

    <div class="d-flex gap-3 align-items-center p-3" style="background:var(--sc-primary-softer);border-radius:14px">
        <img src="@Model.HinhAnh" class="sc-thumb" style="width:70px;height:70px" alt="@Model.TenLoai"
             onerror="this.onerror=null;this.src='https://placehold.co/200x200/FFE6EE/E8517F?text=SC';" />
        <div>
            <div class="fw-bold" style="font-size:17px">@Model.TenLoai</div>
            <div class="sc-text-muted small">@Model.MoTa</div>
        </div>
    </div>

    @if (soSP > 0)
    {
        <div class="sc-alert sc-alert-danger mt-3">
            <i class="bi bi-x-octagon"></i>
            <span>
                Loại này đang có <strong>@soSP sản phẩm</strong>. Bạn phải chuyển các sản phẩm đó sang loại khác
                (hoặc xóa chúng) trước khi xóa loại này.
            </span>
        </div>

        <div class="d-flex gap-2 mt-3">
            <a href="@Url.Action("Index", "QuanLySanPham", new { maLoai = Model.MaLoai })" class="btn btn-sc btn-lg">
                Xem @soSP sản phẩm
            </a>
            <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Quay lại</a>
        </div>
    }
    else
    {
        <div class="sc-alert sc-alert-warning mt-3">
            <i class="bi bi-info-circle"></i>
            <span>Loại này chưa có sản phẩm nào nên có thể xóa an toàn.</span>
        </div>

        <div class="d-flex gap-2 mt-3">
            @using (Html.BeginForm("XacNhanXoa", "QuanLyLoai", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaLoai" />
                <button type="submit" class="btn btn-sc btn-lg"><i class="bi bi-trash"></i> Xác nhận xóa</button>
            }
            <a href="@Url.Action("Index")" class="btn btn-sc-outline btn-lg">Quay lại</a>
        </div>
    }
</div>

@using QL_MatHangAnUong.Helpers
@using QL_MatHangAnUong.Models
@model QL_MatHangAnUong.Models.DonHang
@{
    Layout = "~/Views/Shared/_LayoutSeller.cshtml";
    ViewBag.Title = "Đơn hàng #" + Model.MaDH;

    var cacBuoc = new[] { DonHang.ChoXacNhan, DonHang.DaXacNhan, DonHang.DangGiao, DonHang.HoanThanh };
    int buocHienTai = Array.IndexOf(cacBuoc, Model.TrangThai);
    bool khoa = Model.TrangThai == DonHang.HoanThanh || Model.TrangThai == DonHang.DaHuy;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Đơn hàng #@Model.MaDH</h4>
    <a href="@Url.Action("Index")" class="btn btn-sc-soft"><i class="bi bi-arrow-left"></i> Danh sách đơn</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="sc-panel">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="sc-text-muted">Đặt lúc</span>
                    <strong>@DinhDang.NgayGio(Model.NgayDat)</strong>
                </div>
                <span class="sc-badge @Model.CssTrangThai">@Model.TrangThai</span>
            </div>

            @if (Model.TrangThai != DonHang.DaHuy)
            {
                <div class="sc-timeline mt-4">
                    @for (int i = 0; i < cacBuoc.Length; i++)
                    {
                        <div class="sc-timeline-step @(i <= buocHienTai ? "done" : "")">@cacBuoc[i]</div>
                    }
                </div>
            }

            <hr style="border-color:var(--sc-line)" />

            <div class="table-responsive">
                <table class="table sc-table">
                    <thead>
                        <tr>
                            <th>Món</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietDonHangs)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@ct.TenSP</div>
                                    <div class="sc-text-muted" style="font-size:12.5px">@ct.TuyChon</div>
                                </td>
                                <td class="text-center">@DinhDang.Tien(ct.DonGia)</td>
                                <td class="text-center">@ct.SoLuong</td>
                                <td class="text-end fw-bold">@DinhDang.Tien(ct.ThanhTien)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end sc-text-muted">Tạm tính</td>
                            <td class="text-end">@DinhDang.Tien(Model.TamTinh)</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end sc-text-muted">
                                Giảm giá
                                @if (!string.IsNullOrEmpty(Model.MaGiamGiaApDung))
                                {
                                    <text>(mã @Model.MaGiamGiaApDung.ToUpper())</text>
                                }
                            </td>
                            <td class="text-end">- @DinhDang.Tien(Model.TienGiam)</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end sc-text-muted">Phí giao hàng</td>
                            <td class="text-end">@DinhDang.Tien(Model.PhiGiaoHang)</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng</td>
                            <td class="text-end fw-bold sc-text-primary" style="font-size:18px">@DinhDang.Tien(Model.TongTien)</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end sc-text-muted">Thanh toán (@Model.HinhThucThanhToan)</td>
                            <td class="text-end">
                                @if (Model.DaThanhToan)
                                {
                                    <span class="sc-badge badge-success">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span>Còn thu @DinhDang.Tien(Model.SoTienConLai)</span>
                                }
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sc-panel mb-3">
            <h5 class="mb-3">Khách hàng</h5>
            <div class="fw-bold">@Model.TenNguoiNhan</div>
            <div class="sc-text-muted">@Model.DienThoai</div>
            <div class="sc-text-muted">@Model.DiaChi</div>
            @if (Model.NguoiDung != null)
            {
                <div class="mt-2 small"><i class="bi bi-envelope"></i> @Model.NguoiDung.Email</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div class="sc-alert sc-alert-warning mt-3" style="font-size:13px">
                    <i class="bi bi-chat-left-text"></i>
                    <span>@Model.GhiChu</span>
                </div>
            }
        </div>

        <div class="sc-panel">
            <h5 class="mb-3">Cập nhật trạng thái</h5>

            @if (khoa)
            {
                <div class="sc-alert sc-alert-info" style="font-size:13px">
                    <i class="bi bi-lock"></i>
                    <span>Đơn đã ở trạng thái "@Model.TrangThai" nên không thể thay đổi tiếp.</span>
                </div>
            }
            else
            {
                using (Html.BeginForm("CapNhatTrangThai", "QuanLyDonHang", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaDH" />
                    <input type="hidden" name="quayVe" value="chitiet" />

                    <select name="trangThai" class="form-select mb-2">
                        @foreach (var tt in DonHang.CacTrangThai)
                        {
                            <option value="@tt" selected="@(Model.TrangThai == tt)">@tt</option>
                        }
                    </select>

                    <button type="submit" class="btn btn-sc w-100">
                        <i class="bi bi-arrow-repeat"></i> Cập nhật
                    </button>
                }
            }

            <div class="mt-3 small sc-text-muted">
                Luồng xử lý: Chờ xác nhận → Đã xác nhận → Đang giao → Hoàn thành.
                Chọn "Đã hủy" nếu khách báo hủy đơn.
            </div>
        </div>
    </div>
</div>
